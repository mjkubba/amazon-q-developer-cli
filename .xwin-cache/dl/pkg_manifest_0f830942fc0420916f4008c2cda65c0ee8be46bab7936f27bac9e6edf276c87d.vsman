://download.visualstudio.microsoft.com/download/pr/eef7e5dc-a35b-4a9a-9d6b-84c9f437b646/6f4800c5212763caeb21412dcda0fc74f0d755a95e81bd055e36ae53d049e7fd/Microsoft.VisualStudio.Component.DependencyValidation.Enterprise.Auto.vsix","signer":{"$ref":"1"}}],"installSizes":{"targetDrive":17992}},{"id":"Microsoft.VisualStudio.Component.DependencyValidation.Enterprise.Auto.Resources","version":"17.13.35716.53","type":"Vsix","language":"zh-CN","payloads":[{"fileName":"Microsoft.VisualStudio.Component.DependencyValidation.Enterprise.Auto.vsix","sha256":"23e35957a8160d22e7f84c4c24a0de4bf64bfd4e05455522a2405aeb087ce589","size":12037,"url":"https://download.visualstudio.microsoft.com/download/pr/eef7e5dc-a35b-4a9a-9d6b-84c9f437b646/23e35957a8160d22e7f84c4c24a0de4bf64bfd4e05455522a2405aeb087ce589/Microsoft.VisualStudio.Component.DependencyValidation.Enterprise.Auto.vsix","signer":{"$ref":"1"}}],"installSizes":{"targetDrive":17976}},{"id":"Microsoft.VisualStudio.Component.DependencyValidation.Enterprise.Auto.Resources","version":"17.13.35716.53","type":"Vsix","language":"zh-TW","payloads":[{"fileName":"Microsoft.VisualStudio.Component.DependencyValidation.Enterprise.Auto.vsix","sha256":"67d908deb62b411e31c5c39bf2ffb6c1cd108cc5648f1febbeb6dc4ea790d342","size":12048,"url":"https://download.visualstudio.microsoft.com/download/pr/eef7e5dc-a35b-4a9a-9d6b-84c9f437b646/67d908deb62b411e31c5c39bf2ffb6c1cd108cc5648f1febbeb6dc4ea790d342/Microsoft.VisualStudio.Component.DependencyValidation.Enterprise.Auto.vsix","signer":{"$ref":"1"}}],"installSizes":{"targetDrive":17952}},{"id":"Microsoft.VisualStudio.Component.DiagnosticTools","version":"17.13.35710.127","type":"Component","automaticallyAddedByExtensionPack":false,"dependencies":{"Microsoft.PackageGroup.DiagnosticsHub.Platform":"[17.0,18.0)","Microsoft.PackageGroup.ClientDiagnostics":"[17.0,18.0)","Microsoft.PackageGroup.Icecap.Core":"[17.0,18.0)","Microsoft.DiagnosticsHub.Tools":"[16.0,18.0)"},"localizedResources":[{"language":"en-us","title":".NET profiling tools","description":"Performance profiler and debugger-integrated diagnostic tools for .NET. Includes CPU Usage, Memory Usage, Application Timeline, and the Performance Explorer.","category":"Debugging and testing","keywords":["profiling","profiler","diagnostic tools","diagnostics","memory","CPU","performance","debugging"]},{"language":"zh-cn","title":".NET 分析工具","description":"适用于 .NET 的性能探查器和调试程序集成诊断工具。包含 CPU 使用情况、内存使用情况、应用程序时间线和性能资源管理器。","category":"调试和测试","keywords":["分析","探查器","诊断工具","诊断","内存","CPU","性能","正在调试"]},{"language":"zh-tw","title":".NET 分析工具","description":"整合了效能分析工具與偵錯工具的 .NET 診斷工具。包括 CPU 使用量、記憶體使用量、應用程式時間軸以及效能總管。","category":"偵錯和測試","keywords":["profiling","profiler","診斷工具","diagnostics","memory","CPU","效能","debugging"]},{"language":"cs-cz","title":"Nástroje pro profilaci .NET","description":"Profiler výkonu a diagnostické nástroje integrované v ladicím programu pro .NET. Zahrnuje Využití procesoru, Využití paměti, Časovou osu aplikace a Prohlížeč výkonu.","category":"Ladění a testování","keywords":["profilace","profiler","diagnostické nástroje","diagnostika","paměť","Procesor","výkon","ladění"]},{"language":"de-de","title":".NET-Profilerstellungstools","description":"Leistungs-Profiler und in den Debugger integrierte Diagnosetools für .NET. Umfasst CPU-Auslastung, Speicherauslastung, Anwendungzeitachse und den Leistungs-Explorer.","category":"Debuggen und Testen","keywords":["Profilerstellung","Profiler","Diagnosetools","Diagnose","Arbeitsspeicher","CPU","Leistung","Debuggen"]},{"language":"es-es","title":"Herramientas para generación de perfiles de .NET","description":"Generador de perfiles de rendimiento y herramientas de diagnóstico con depurador integrado para .NET. Incluyen el uso de la CPU, el uso de memoria, la escala de tiempo de la aplicación y el Explorador de rendimiento.","category":"Depuración y pruebas","keywords":["generación de perfiles","generador de perfiles","herramientas de diagnóstico","diagnósticos","memoria","CPU","rendimiento","depuración"]},{"language":"fr-fr","title":"Outils de profilage .NET","description":"Profileur de performances et outils de diagnostic intégrés au débogueur pour .NET. Inclut les outils relatifs à l'utilisation de l'UC, l'utilisation de la mémoire, la chronologie de l'application et l'Explorateur de performances.","category":"Débogage et tests","keywords":["profilage","profileur","outils de diagnostic","diagnostics","mémoire","UC","performances","débogage"]},{"language":"it-it","title":"Strumenti di profilatura .NET","description":"Profiler prestazioni e strumenti di diagnostica integrati nel debugger per .NET. Include Utilizzo CPU, Utilizzo memoria, Sequenza temporale applicazione ed Esplora prestazioni.","category":"Debug e test","keywords":["profilatura","profiler","strumenti di diagnostica","diagnostica","memoria","CPU","prestazioni","debug"]},{"language":"ja-jp","title":".NET プロファイル ツール","description":".NET 用のパフォーマンス プロファイラーおよびデバッガーの統合診断ツール。CPU 使用率、メモリ使用量、Application Timeline、パフォーマンス エクスプローラーが含まれます。","category":"デバッグとテスト","keywords":["プロファイル","プロファイラー","診断ツール","診断","メモリ","CPU","パフォーマンス","デバッグ"]},{"language":"ko-kr","title":".NET 프로파일링 도구","description":".NET용 성능 프로파일러 및 디버거 통합 진단 도구입니다. CPU 사용량, 메모리 사용량, 애플리케이션 타임라인 및 성능 탐색기를 포함합니다.","category":"디버깅 및 테스트","keywords":["프로파일링","프로파일러","진단 도구","진단","메모리","CPU","성능","디버깅"]},{"language":"pl-pl","title":"Narzędzia profilowania dla programu .NET","description":"Profiler wydajności i narzędzia diagnostyczne zintegrowane z debugerem dla programu .NET. Obejmuje informacje o użyciu procesora CPU i pamięci, oś czasu aplikacji oraz Eksploratora wydajności.","category":"Debugowanie i testowanie","keywords":["profilowanie","profiler","narzędzia diagnostyczne","diagnostyka","pamięć","CPU","wydajność","debugowanie"]},{"language":"pt-br","title":"Ferramentas de criação de perfil do .NET","description":"Criador de perfil de desempenho e ferramentas de diagnóstico integradas ao depurador. Inclui Uso de CPU, Uso de Memória, Linha do Tempo do Aplicativo e Gerenciador de Desempenho.","category":"Depuração e testes","keywords":["criação de perfil","criador de perfil","ferramentas de diagnóstico","diagnóstico","memória","CPU","desempenho","depuração"]},{"language":"ru-ru","title":"Средства профилирования .NET","description":"Профилировщик производительности и интегрированные в отладчик средства диагностики для .NET. Включает загрузку ЦП, использование памяти, временную шкалу приложения и обозреватель производительности.","category":"Отладка и тестирование","keywords":["профилирование","профилировщик","средства диагностики","диагностика","память","ЦП","производительность","отладка"]},{"language":"tr-tr","title":".NET profil oluşturma araçları","description":".NET için performans profili oluşturucu ve hata ayıklayıcısıyla tümleştirilmiş tanılama araçları. CPU Kullanımı, Bellek Kullanımı, Uygulama Zaman Çizelgesi ve Performans Gezgini araçlarını içerir.","category":"Hata ayıklama ve test","keywords":["profil oluşturma","profil oluşturucu","tanılama araçları","tanılama","bellek","CPU","performans","hata ayıklama"]}]},{"id":"Microsoft.VisualStudio.Component.DockerTools","version":"17.13.35710.127","type":"Component","automaticallyAddedByExtensionPack":false,"dependencies":{"Microsoft.NetCore.Component.SDK":"[17.0,18.0)","Microsoft.VisualStudio.Package.DockerTools":"0.50","Microsoft.VisualStudio.Package.DockerTools.BuildTools":"0.50","Microsoft.VisualStudio.Package.ContainersTools":"0.1","Microsoft.VisualStudio.Containers.Tools.Extensions":"0.1","Microsoft.VisualStudio.ComponentGroup.WebToolsExtensions":"[17.0,18.0)","Microsoft.VisualStudio.VC.Ide.MDD":"[17.0,18.0)","Microsoft.VisualStudio.Debugger.OneCore.x64":"[17.0,18.0)","Microsoft.VisualStudio.Debugger.OneCore.x86":"[17.0,18.0)"},"localizedResources":[{"language":"en-us","title":"Container development tools","description":"Develop, run, validate your .NET applications in the target environment. F5 your application directly into a container with debugging, or CTRL + F5 to edit & refresh your app without having to rebuild the container.","category":"Cloud, database, and server","keywords":["containers","azure","docker","deploy","deployment","debug","project","tools"]},{"language":"zh-cn","title":"容器开发工具","description":"在目标环境中开发、运行、验证 .NET 应用程序。按 F5 直接在容器中调试应用程序，或者按 Ctrl+F5 编辑和刷新应用，无需重新生成容器。","category":"云、数据库和服务器","keywords":["容器","azure","docker","部署","部署","调试","项目","工具"]},{"language":"zh-tw","title":"容器開發工具","description":"在目標環境中開發、執行、驗證您的 .NET 應用程式。按 F5 鍵可讓應用程式能直接進入偵錯模式的容器，或按 CTRL + F5 鍵編輯及重新整理您的應用程式，而無須重建容器。","category":"雲端、資料庫和伺服器","keywords":["containers","azure","docker","deploy","deployment","偵錯","project","tools"]},{"language":"cs-cz","title":"Vývojové nástroje pro kontejnery","description":"Umožňují vyvíjet, spouštět a ověřovat aplikace .NET v cílovém prostředí. Stisknutím klávesy F5 převedete aplikaci přímo do kontejneru s laděním. Když stisknete kombinaci kláves CTRL+F5, můžete aplikaci upravit a aktualizovat bez nutnosti znovu sestavovat kontejner.","category":"Cloud, databáze a server","keywords":["kontejnery","azure","docker","nasadit","nasazení","ladit","projekt","nástroje"]},{"language":"de-de","title":"Containerentwicklungstools","description":"Entwickeln Sie Ihre ASP.NET Core-Anwendung in der Zielumgebung, führen Sie sie aus, und überprüfen Sie sie. Drücken Sie F5, um die Anwendung direkt in einem Container mit Debugfunktionen auszuführen, oder STRG+F5 zum Bearbeiten und Aktualisieren Ihrer App, ohne den Container erneut erstellen zu müssen.","category":"Cloud, Datenbank und Server","keywords":["Container","azure","Docker","Bereitstellen","Bereitstellung","Debuggen","Projekt","Tools"]},{"language":"es-es","title":"Herramientas de desarrollo de contenedor","description":"Desarrolle, ejecute y valide sus aplicaciones de .NET en el entorno de destino. Presione F5 para ejecutar la aplicación directamente en un contenedor con opción de depuración, o bien presione CTRL + F5 para editar y actualizar la aplicación sin necesidad de recompilar el contenedor.","category":"Nube, base de datos y servidor","keywords":["contenedores","azure","docker","implementar","implementación","depurar","proyecto","herramientas"]},{"language":"fr-fr","title":"Outils de développement de conteneur","description":"Développez, exécutez et validez vos applications .NET dans l'environnement cible. Appuyez sur F5 pour exécuter votre application directement dans un conteneur avec débogage, ou sur CTRL+F5 pour modifier et actualiser votre application sans avoir à regénérer le conteneur.","category":"Cloud, base de données et serveur","keywords":["conteneurs","azure","docker","déployer","déploiement","déboguer","projet","outils"]},{"language":"it-it","title":"Strumenti di sviluppo contenitori","description":"Consente di sviluppare, eseguire e convalidare applicazioni .NET nell'ambiente di destinazione. Premere F5 per modificare l'applicazione direttamente in un contenitore con debug oppure CTRL+F5 per modificare e aggiornare l'app senza ricompilare il contenitore.","category":"Cloud, database e server","keywords":["contenitori","azure","docker","distribuire","distribuzione","debug","progetto","strumenti"]},{"language":"ja-jp","title":"コンテナー開発ツール","description":"ターゲット環境で .NET アプリケーションを開発、実行、検証します。F5 キーを押してコンテナーで直接アプリケーションをデバッグ実行するか、Ctrl + F5 キーを押してコンテナーをリビルドせずにアプリを編集して更新します。","category":"クラウド、データベース、およびサーバー","keywords":["コンテナー","azure","docker","配置","配置","デバッグ","プロジェクト","ツール"]},{"language":"ko-kr","title":"컨테이너 개발 도구","description":"대상 환경에서 .NET 애플리케이션의 개발, 실행, 유효성 검사를 진행합니다. 디버깅을 설정한 상태로 컨테이너에 직접 배포하려면 F5 키를 누르고, 컨테이너를 다시 빌드하지 않고 앱을 편집하고 새로 고치려면 Ctrl+F5를 누르세요.","category":"클라우드, 데이터베이스 및 서버","keywords":["컨테이너","Azure","docker","배포","배포","디버그","프로젝트","도구"]},{"language":"pl-pl","title":"Narzędzia programistyczne dla kontenerów","description":"Twórz, uruchamiaj i weryfikuj aplikacje programu .NET w środowisku docelowym. Używaj klawisza F5, aby uruchamiać aplikację z debugowaniem bezpośrednio w kontenerze, lub klawiszy CTRL+F5, aby edytować i odświeżać aplikację bez konieczności ponownego kompilowania kontenera.","category":"Chmura, baza danych i serwer","keywords":["kontenery","azure","docker","wdróż","wdrożenie","debuguj","projekt","narzędzia"]},{"language":"pt-br","title":"Ferramentas de desenvolvimento do Contêiner","description":"Desenvolva, execute e valide seus aplicativos .NET no ambiente de destino. Pressione F5 no seu aplicativo diretamente em um contêiner com depuração ou digite CTRL + F5 para editar e atualizar seu aplicativo sem precisar recompilar o contêiner.","category":"Nuvem, banco de dados e servidor","keywords":["contêineres","azure","docker","implantar","implantação","depurar","projeto","ferramentas"]},{"language":"ru-ru","title":"Средства разработки контейнеров","description":"Разработка, запуск и проверка приложений .NET в целевой среде. Нажав клавишу F5, можно отправить приложение напрямую в контейнер с отладкой, а клавиши CTRL+F5 позволяют изменить и обновить приложение без повторной сборки контейнера.","category":"Облако, база данных и сервер","keywords":["контейнеры","azure","Docker","развернуть","развертывание","отладка","проект","инструменты"]},{"language":"tr-tr","title":"Kapsayıcı geliştirme araçları","description":".NET uygulamalarınızı hedef ortamda geliştirin, çalıştırın ve doğrulayın. F5 tuşuna basarak uygulamanızı hata ayıklama özelliği içeren bir kapsayıcıya doğrudan alın veya CTRL+F5 tuşlarına basarak kapsayıcıyı yeniden derlemeye gerek kalmadan uygulamanızı düzenleyin ve yenileyin.","category":"Bulut, veritabanı ve sunucu","keywords":["kapsayıcılar","azure","docker","dağıtma","dağıtım","hata ayıklama","proje","araçlar"]}]},{"id":"Microsoft.VisualStudio.Component.DockerTools.BuildTools","version":"17.13.35710.127","type":"Component","automaticallyAddedByExtensionPack":false,"dependencies":{"Microsoft.VisualStudio.Package.DockerTools.BuildTools":"0.50"},"localizedResources":[{"language":"en-us","title":"Container development tools - Build Tools","description":"Build your applications in the target container environment.","category":"Cloud, database, and server","keywords":["containers","azure","docker","deploy","deployment","debug","project","tools","msbuild"]},{"language":"zh-cn","title":"容器开发工具 - 生成工具","description":"在目标容器环境中生成应用程序。","category":"云、数据库和服务器","keywords":["容器","azure","docker","部署","部署","调试","项目","工具","msbuild"]},{"language":"zh-tw","title":"容器開發工具 - 建置工具","description":"在目標容器的環境中建置您的應用程式。","category":"雲端、資料庫和伺服器","keywords":["containers","azure","docker","deploy","deployment","偵錯","project","tools","msbuild"]},{"language":"cs-cz","title":"Kontejnerové vývojové nástroje – Build Tools","description":"Sestaví vaše aplikace v prostředí cílového kontejneru.","category":"Cloud, databáze a server","keywords":["kontejnery","azure","docker","nasadit","nasazení","ladit","projekt","nástroje","msbuild"]},{"language":"de-de","title":"Containerentwicklungstools – Buildtools","description":"Hiermit werden Ihre Anwendungen in der Zielcontainerumgebung erstellt.","category":"Cloud, Datenbank und Server","keywords":["Container","azure","Docker","Bereitstellen","Bereitstellung","Debuggen","Projekt","Tools","MSBuild"]},{"language":"es-es","title":"Herramientas de desarrollo de contenedor: herramientas de compilación","description":"Compile las aplicaciones en el entorno del contenedor de destino.","category":"Nube, base de datos y servidor","keywords":["contenedores","azure","docker","implementar","implementación","depurar","proyecto","herramientas","msbuild"]},{"language":"fr-fr","title":"Outils de développement de conteneur - Build Tools","description":"Générez vos applications dans l'environnement du conteneur cible.","category":"Cloud, base de données et serveur","keywords":["conteneurs","azure","docker","déployer","déploiement","déboguer","projet","outils","msbuild"]},{"language":"it-it","title":"Strumenti di sviluppo contenitori - Strumenti di compilazione","description":"Consente di creare applicazioni nell'ambiente del contenitore di destinazione.","category":"Cloud, database e server","keywords":["contenitori","azure","docker","distribuire","distribuzione","debug","progetto","strumenti","msbuild"]},{"language":"ja-jp","title":"コンテナーの開発ツール - Build Tools","description":"ターゲット コンテナー環境でアプリケーションをビルドします。","category":"クラウド、データベース、およびサーバー","keywords":["コンテナー","azure","docker","配置","配置","デバッグ","プロジェクト","ツール","msbuild"]},{"language":"ko-kr","title":"컨테이너 개발 도구 - 빌드 도구","description":"대상 컨테이너 환경에서 애플리케이션을 빌드합니다.","category":"클라우드, 데이터베이스 및 서버","keywords":["컨테이너","Azure","docker","배포","배포","디버그","프로젝트","도구","msbuild"]},{"language":"pl-pl","title":"Narzędzia programistyczne kontenera — narzędzia kompilacji","description":"Kompiluj aplikacje w docelowym środowisku kontenera.","category":"Chmura, baza danych i serwer","keywords":["kontenery","azure","docker","wdróż","wdrożenie","debuguj","projekt","narzędzia","msbuild"]},{"language":"pt-br","title":"Ferramentas de desenvolvimento de contêiner – Ferramentas de Build","description":"Compile seus aplicativos no ambiente do contêiner de destino.","category":"Nuvem, banco de dados e servidor","keywords":["contêineres","azure","docker","implantar","implantação","depurar","projeto","ferramentas","msbuild"]},{"language":"ru-ru","title":"Средства разработки для контейнеров — средства сборки","description":"Создавайте приложения в целевой среде контейнера.","category":"Облако, база данных и сервер","keywords":["контейнеры","azure","Docker","развернуть","развертывание","отладка","проект","инструменты","MSBuild"]},{"language":"tr-tr","title":"Kapsayıcı geliştirme araçları - Derleme Araçları","description":"Hedef kapsayıcı ortamında uygulamalarınızı derleyin.","category":"Bulut, veritabanı ve sunucu","keywords":["kapsayıcılar","azure","docker","dağıtma","dağıtım","hata ayıklama","proje","araçlar","msbuild"]}]},{"id":"Microsoft.VisualStudio.Component.DotNetModelBuilder","version":"17.13.35710.127","type":"Component","automaticallyAddedByExtensionPack":false,"dependencies":{"Microsoft.ML.ModelBuilder":"16.1"},"localizedResources":[{"language":"en-us","title":"ML.NET Model Builder","description":"Simple UI tool for developers to build, train, and ship custom machine learning models in their .NET applications.","category":".NET","keywords":["AI","ML","ML.NET","Machine Learning","Model Builder",".NET Core",".NET","Cloud","Azure","Tools"]},{"language":"zh-cn","title":"ML.NET Model Builder","description":"开发人员用于在其 .NET 应用程序中生成、训练和交付自定义机器学习模型的简单 UI 工具。","category":".NET","keywords":["AI","ML","ML.NET","机器学习","Model Builder",".NET Core",".NET","云","Azure","工具"]},{"language":"zh-tw","title":"ML.NET Model Builder","description":"簡易 UI 工具，可讓開發人員在其 .NET 應用程式中建置、訓練及提供自訂機器學習模型。","category":".NET","keywords":["AI","ML","ML.NET","機器學習服務","Model Builder",".NET Core",".NET","雲端","Azure","工具"]},{"language":"cs-cz","title":"ML.NET Model Builder","description":"Jednoduchý nástroj s uživatelským rozhraním, se kterým vývojáři můžou vytvářet, trénovat a dodávat vlastní modely strojového učení v aplikacích .NET","category":".NET","keywords":["AI","ML","ML.NET","Machine Learning","Model Builder",".NET Core",".NET","Cloud","Azure","Nástroje"]},{"language":"de-de","title":"ML.NET Model Builder","description":"Einfaches Benutzeroberflächentool für Entwickler zum Erstellen, Trainieren und Liefern von benutzerdefinierten Machine Learning-Modellen in ihren .NET-Anwendungen.","category":".NET","keywords":["KI","ML","ML.NET","Machine Learning","Model Builder",".NET Core",".NET","Cloud","Azure","Tools"]},{"language":"es-es","title":"ML.NET Model Builder","description":"Herramienta de interfaz de usuario sencilla para que los desarrolladores puedan compilar, entrenar y enviar modelos de Machine Learning personalizados en sus aplicaciones .NET.","category":".NET","keywords":["IA","ML","ML.NET","Machine Learning","Model Builder",".NET Core",".NET","Nube","Azure","Herramientas"]},{"language":"fr-fr","title":"ML.NET Model Builder","description":"Outil d'IU simple qui permet aux développeurs de générer, d'entraîner et de fournir des modèles Machine Learning personnalisés dans leurs applications .NET.","category":".NET","keywords":["IA","ML","ML.NET","Machine Learning","Model Builder",".NET Core",".NET","Cloud","Azure","Outils"]},{"language":"it-it","title":"ML.NET Model Builder","description":"Strumento semplice dell'interfaccia utente per gli sviluppatori per compilare, eseguire il training e distribuire modelli di Machine Learning personalizzati nelle applicazioni .NET.","category":".NET","keywords":["Intelligenza artificiale","ML","ML.NET","Machine Learning","Model Builder",".NET Core",".NET","Cloud","Azure","Strumenti"]},{"language":"ja-jp","title":"ML.NET Model Builder","description":"開発者がカスタム機械学習モデルを作成、トレーニングし、.NET アプリケーションに組み込んで出荷するための簡単な UI ツール。","category":".NET","keywords":["AI","ML","ML.NET","機械学習","Model Builder",".NET Core",".NET","クラウド","Azure","ツール"]},{"language":"ko-kr","title":"ML.NET Model Builder","description":"개발자가 .NET 애플리케이션에서 사용자 지정 기계 학습 모델을 빌드 및 제공하고 학습시키는 간단한 UI 도구입니다.","category":".NET","keywords":["AI","ML","ML.NET","Machine Learning","Model Builder",".NET Core",".NET","클라우드","Azure","도구"]},{"language":"pl-pl","title":"ML.NET Model Builder","description":"Proste narzędzie interfejsu użytkownika umożliwiające deweloperom tworzenie, trenowanie i dostarczanie niestandardowych modeli uczenia maszynowego w aplikacjach platformy .NET.","category":".NET","keywords":["AI","ML","ML.NET","Machine Learning","Model Builder",".NET Core",".NET","Chmura","Azure","Narzędzia"]},{"language":"pt-br","title":"ML.NET Model Builder","description":"Ferramenta de interface do usuário simples para que os desenvolvedores criem, treinem e enviem modelos de machine learning personalizados para seus aplicativos .NET.","category":".NET","keywords":["IA","ML","ML.NET","Machine Learning","Model Builder",".NET Core",".NET","Nuvem","Azure","Ferramentas"]},{"language":"ru-ru","title":"ML.NET Model Builder","description":"Простой инструмент с пользовательским интерфейсом, позволяющий разработчикам создавать, обучать и публиковать настраиваемые модели машинного обучения в своих приложениях .NET.","category":".NET","keywords":["ИИ","ML","ML.NET","Машинное обучение","Model Builder",".NET Core",".NET","Облако","Azure","Инструменты"]},{"language":"tr-tr","title":"ML.NET Model Builder","description":"Geliştiricilerin .NET uygulamalarında özel makine öğrenimi modelleri oluşturmalarına, eğiterek ve sevk etmelerine yönelik basit UI aracı.","category":".NET","keywords":["Toplu AI","ml ","ML.NET","Makine Öğrenmesi","Model Builder",".NET Core",".NET","Bulut","Azure","Araçlar"]}]},{"id":"Microsoft.VisualStudio.Component.DslTools","version":"17.13.35710.127","type":"Component","automaticallyAddedByExtensionPack":false,"dependencies":{"Microsoft.VisualStudio.Dsl.Sdk":"[17.0,18.0)","Microsoft.VisualStudio.PackageGroup.DslRuntime":"[17.0,18.0)","Microsoft.VisualStudio.Component.TextTemplating":"[17.0,18.0)","Microsoft.VisualStudio.Component.VSSDK":"[17.0,18.0)"},"localizedResources":[{"language":"en-us","title":"Modeling SDK","description":"Create domain model-based graphical or form designers that you can integrate into Visual Studio using Domain-Specific Languages (DSLs)","category":"SDKs, libraries, and frameworks"},{"language":"zh-cn","title":"建模 SDK","description":"创建基于域模型的图形或窗体设计器，可使用特定于域的语言(DSL)将其集成到 Visual Studio 中","category":"SDK、库和框架"},{"language":"zh-tw","title":"Modeling SDK","description":"使用特定領域語言 (DSL)，建立可整合至 Visual Studio 的領域模型圖形或表單設計工具","category":"SDK、程式庫和架構"},{"language":"cs-cz","title":"Modeling SDK","description":"Vytvořte si grafické nebo formulářové návrháře na základě doménového modelu, které můžete integrovat do sady Visual Studio pomocí jazyků specifických pro doménu (DSL).","category":"Sady SDK, knihovny a architektury"},{"language":"de-de","title":"DSL-Tools","description":"Erstellt die auf dem Domänenmodell basierenden grafischen Designer oder Formulardesigner, die in Visual Studio mithilfe domänenspezifischer Sprachen (Domain-Specific Languages, DSLs) integriert werden können.","category":"SDKs, Bibliotheken und Frameworks"},{"language":"es-es","title":"SDK de modelado","description":"Crea diseñadores de formularios o gráficos basados en modelos de dominio que pueden integrarse en Visual Studio mediante lenguajes específicos de dominio (DSL)","category":"SDK, bibliotecas y marcos"},{"language":"fr-fr","title":"Modeling SDK","description":"Créez des concepteurs de formulaires ou des concepteurs graphiques basés sur un modèle de domaine, que vous pouvez intégrer à Visual Studio via les langages dédiés (Domain-Specific Languages, DSL)","category":"SDK, bibliothèques et frameworks"},{"language":"it-it","title":"Strumenti DSL","description":"Consente di creare finestre di progettazione forme o grafiche basate su modello di dominio che è possibile integrare in Visual Studio con DSL (linguaggio specifico di dominio)","category":"SDK, librerie e framework"},{"language":"ja-jp","title":"Modeling SDK","description":"ドメイン固有言語 (DSL) を使用して Visual Studio に統合できるドメイン モデルベースのグラフィカル デザイナーまたはフォーム デザイナーを作成します","category":"SDK、ライブラリ、およびフレームワーク"},{"language":"ko-kr","title":"Modeling SDK","description":"DSL(도메인 특정 언어)을 사용하여 Visual Studio에 통합할 수 있는 도메인 모델 기반 그래픽 디자이너 또는 양식 디자이너를 만듭니다.","category":"SDK, 라이브러리 및 프레임워크"},{"language":"pl-pl","title":"Modeling SDK","description":"Tworzenie projektantów formularzy lub graficznych opartych na modelu, których można zintegrować z programem Visual Studio za pomocą języków specyficznych dla domeny (DSL), na potrzeby domeny","category":"Zestawy SDK, biblioteki i struktury"},{"language":"pt-br","title":"Ferramentas DSL","description":"Crie designers gráficos ou de formulários baseados em modelos de domínio que você pode integrar ao Visual Studio usando DSLs (Linguagens Específicas de Domínio)","category":"SDKs, bibliotecas e estruturas"},{"language":"ru-ru","title":"Пакет SDK для моделирования","description":"Создание конструкторов графических элементов или форм на основе модели предметной области, которые можно интегрировать в Visual Studio с помощью предметно-ориентированных языков (DSL)","category":"Пакеты SDK, библиотеки и платформы"},{"language":"tr-tr","title":"DSL araçları","description":"Alana Özgü Diller (DSL) kullanarak Visual Studio ile tümleştirebileceğiniz alan modeli tabanlı grafik veya form tasarımcıları oluşturun","category":"SDK'lar, kitaplıklar ve çerçeveler"}]},{"id":"Microsoft.VisualStudio.Component.Embedded","version":"17.13.35710.127","type":"Component","ui":{"isAdvertisedPackage":true},"automaticallyAddedByExtensionPack":false,"dependencies":{"Microsoft.VisualStudio.LiveShare.2022":"","Microsoft.VisualStudio.Embedded":"[17.0,18.0)","Microsoft.VisualStudio.VisualC.Utilities":"[17.0,18.0)"},"localizedResources":[{"language":"en-us","title":"Embedded and IoT tools","description":"Enables building and debugging applications for embedded devices.","category":"Development activities"},{"language":"zh-cn","title":"嵌入式和 IoT 工具","description":"支持适用于嵌入式设备的生成和调试应用程序。","category":"开发活动"},{"language":"zh-tw","title":"內嵌與 IoT 工具","description":"允許為內嵌裝置建置應用程式及對應用程式偵錯。","category":"開發活動"},{"language":"cs-cz","title":"Nástroje Embedded a IoT","description":"Umožňuje vytvářet a ladit aplikace pro vestavěná zařízení.","category":"Vývojové aktivity"},{"language":"de-de","title":"Embedded- und IoT-Tools","description":"Ermöglicht das Erstellen und Debuggen von Anwendungen für eingebettete Geräte.","category":"Entwicklungsaktivitäten"},{"language":"es-es","title":"Herramientas de IoT e incrustadas","description":"Habilita la compilación y depuración de aplicaciones para dispositivos incrustados.","category":"Actividades de desarrollo"},{"language":"fr-fr","title":"Outils embarqués et IoT","description":"Permet de créer et de déboguer des applications pour les appareils embarqués.","category":"Activités de développement"},{"language":"it-it","title":"Strumenti incorporati e IoT","description":"Consente la compilazione e il debug di applicazioni per dispositivi incorporati.","category":"Attività di sviluppo"},{"language":"ja-jp","title":"埋め込みツールと IoT ツール","description":"埋め込みデバイスのアプリケーションのビルドとデバッグを有効にします。","category":"開発作業"},{"language":"ko-kr","title":"임베디드 및 IoT 도구","description":"포함된 디바이스에 대한 애플리케이션을 빌드 및 디버깅할 수 있습니다.","category":"개발 작업"},{"language":"pl-pl","title":"Narzędzia osadzone i IoT","description":"Umożliwia kompilowanie i debugowanie aplikacji dla osadzonych urządzeń.","category":"Działania programistyczne"},{"language":"pt-br","title":"Ferramentas inseridas e IoT","description":"Habilita a criação e a depuração de aplicativos para dispositivos inseridos.","category":"Atividades de desenvolvimento"},{"language":"ru-ru","title":"Встроенные инструменты и инструменты Интернета вещей","description":"Включает сборку и отладку приложений для встроенных устройств.","category":"Действия разработки"},{"language":"tr-tr","title":"Ekli ve IoT araçları","description":"Gömülü cihazlar için uygulama oluşturmayı ve uygulamalarda hata ayıklamayı etkinleştirir.","category":"Geliştirme etkinlikleri"}]},{"id":"Microsoft.VisualStudio.Component.EntityFramework","version":"17.13.35710.127","type":"Component","automaticallyAddedByExtensionPack":false,"dependencies":{"Microsoft.VisualStudio.EntityFrameworkTools.Msi":"6.1.0.0","Microsoft.VisualStudio.EntityFrameworkTools":"15.0.0.0","Microsoft.VisualStudio.Component.TextTemplating":"[17.0,18.0)","Microsoft.VisualStudio.PackageGroup.Community":"[17.0,18.0)","Microsoft.VisualStudio.PackageGroup.DslRuntime":"[17.0,18.0)","Microsoft.VisualStudio.ProTools":"[17.0,18.0)"},"localizedResources":[{"language":"en-us","title":"Entity Framework 6 tools","description":"Visual design surface and wizard for authoring models that map .NET objects to relational data using EF 6 and previous versions.","category":"SDKs, libraries, and frameworks"},{"language":"zh-cn","title":"Entity Framework 6 工具","description":"用于创作模型的可视化设计图面和向导，这些模型可使用 EF6 及以前版本将 .NET 对象映射到关系数据。","category":"SDK、库和框架"},{"language":"zh-tw","title":"Entity Framework 6 工具","description":"此視覺化設計介面與精靈可讓您使用 EF 6 與更舊版本撰寫將 .NET 物件對應到關聯式資料的模型。","category":"SDK、程式庫和架構"},{"language":"cs-cz","title":"Entity Framework 6 Tools","description":"Vizuální návrhová plocha a průvodce vytvářením modelů, které mapují objekty .NET na relační data, pomocí EF 6 a předchozích verzí","category":"Sady SDK, knihovny a architektury"},{"language":"de-de","title":"Entity Framework 6-Tools","description":"Visuelle Entwurfsoberfläche und Assistent zum Erstellen von Modellen, die .NET-Objekte relationalen Daten mithilfe von EF 6 und früheren Versionen zuordnen.","category":"SDKs, Bibliotheken und Frameworks"},{"language":"es-es","title":"Herramientas de Entity Framework 6","description":"Superficie y asistente de diseño visual para la creación de modelos que asignan objetos .NET a datos relacionales mediante EF 6 y versiones anteriores.","category":"SDK, bibliotecas y marcos"},{"language":"fr-fr","title":"Entity Framework 6 Tools","description":"Aire de conception visuelle et Assistant pour la création de modèles qui mappent des objets .NET à des données relationnelles à l'aide d'EF 6 et des versions antérieures.","category":"SDK, bibliothèques et frameworks"},{"language":"it-it","title":"Strumenti di Entity Framework 6","description":"Area di progettazione visiva e procedura guidata per la creazione di modelli che associano oggetti .NET a dati relazionali usando EF 6 e versioni precedenti.","category":"SDK, librerie e framework"},{"language":"ja-jp","title":"Entity Framework 6 Tools","description":"EF 6 以前のバージョンを使用して .NET オブジェクトをリレーショナル データにマップするモデルを作成するためのビジュアル デザイン サーフェイスとウィザード。","category":"SDK、ライブラリ、およびフレームワーク"},{"language":"ko-kr","title":"Entity Framework 6 도구","description":"EF 6 및 이전 버전을 사용하여 .NET 개체를 관계형 데이터에 매핑하는 모델을 제작하는 데 사용되는 시각 디자인 화면 및 마법사입니다.","category":"SDK, 라이브러리 및 프레임워크"},{"language":"pl-pl","title":"Entity Framework 6 Tools","description":"Kreator i powierzchnia projektowania wizualnego służące do tworzenia modeli mapujących obiekty .NET na dane relacyjne przy użyciu programu EF 6 i poprzednich wersji.","category":"Zestawy SDK, biblioteki i struktury"},{"language":"pt-br","title":"Ferramentas do Entity Framework 6","description":"Assistente e área de design visual para criar modelos que mapeiem objetos .NET com os dados relacionais usando EF 6 e versões anteriores.","category":"SDKs, bibliotecas e estruturas"},{"language":"ru-ru","title":"Инструменты для Entity Framework 6","description":"Рабочая область визуального конструирования и мастер создания моделей, сопоставляющий объекты .NET с реляционными данными с помощью EF 6 и предыдущих версий.","category":"Пакеты SDK, библиотеки и платформы"},{"language":"tr-tr","title":"Entity Framework 6 Tools","description":"EF 6 ve önceki sürümleri aracılığıyla .NET nesnelerini ilişkisel verilere eşleyen yazma modellerine yönelik görsel tasarım yüzeyi ve sihirbaz.","category":"SDK'lar, kitaplıklar ve çerçeveler"}]},{"id":"Microsoft.VisualStudio.Component.FSharp","version":"17.13.35710.127","type":"Component","automaticallyAddedByExtensionPack":false,"dependencies":{"Microsoft.FSharp.IDE_-2066987101":{"id":"Microsoft.FSharp.IDE","version":"[16.0,18.0)","when":["Microsoft.VisualStudio.Product.CommunityX86","Microsoft.VisualStudio.Product.EnterpriseX86","Microsoft.VisualStudio.Product.ProfessionalX86","Microsoft.VisualStudio.Product.Community","Microsoft.VisualStudio.Product.Enterprise","Microsoft.VisualStudio.Product.Professional"]},"Microsoft.VisualStudio.MinShell":"[17.0,18.0)","Microsoft.VisualStudio.PackageGroup.Community":"[17.0,18.0)","Microsoft.VisualStudio.Component.NuGet":"[17.0,18.0)","Microsoft.Net.Component.4.7.2.TargetingPack":"[17.0,18.0)","Microsoft.VisualStudio.Component.Roslyn.LanguageServices":"[17.0,18.0)"},"localizedResources":[{"language":"en-us","title":"F# lang