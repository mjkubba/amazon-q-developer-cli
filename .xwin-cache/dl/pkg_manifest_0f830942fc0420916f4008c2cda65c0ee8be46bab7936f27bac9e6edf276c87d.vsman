[14.0,18.0)","Microsoft.VisualC.14.16.CLI.X64":"[14.0,18.0)","Microsoft.VisualC.14.16.CLI.X86":"[14.0,18.0)"},"localizedResources":[{"language":"en-us","title":"C++/CLI support for v141 build tools (14.16)","description":"Required tools and frameworks for code editing and debugging C++/CLI applications using the .NET framework.","category":"Compilers, build tools, and runtimes"},{"language":"zh-cn","title":"对 v141 生成工具(14.16)的 C++/CLI 支持","description":"使用 .NET 框架对 C++/CLI 应用程序进行代码编辑和调试所需的工具和框架。","category":"编译器、生成工具和运行时"},{"language":"zh-tw","title":"適用於 v141 建置工具的 C++/CLI 支援 (14.16)","description":"使用 .NET Framework 進行 C++/CLI 應用程式程式碼編輯與偵錯的必要工具與架構。","category":"編譯器、建置工具和執行階段"},{"language":"cs-cz","title":"Podpora C++/CLI pro nástroje sestavení v141 (14.16)","description":"Požadované nástroje a rozhraní pro úpravy kódu a ladění aplikací C++/CLI pomocí rozhraní .NET Framework","category":"Kompilátory, nástroje pro sestavování buildů a moduly runtime"},{"language":"de-de","title":"C++-/CLI-Unterstützung für v141-Buildtools (14.16)","description":"Erforderliche Tools und Frameworks für die Codebearbeitung und das Debuggen von C++-/CLI-Anwendungen mithilfe von .NET Framework.","category":"Compiler, Buildtools und Runtimes"},{"language":"es-es","title":"Compatibilidad con C++/CLI para las herramientas de compilación de v141 (14.16)","description":"Herramientas y marcos de trabajo necesarios para la edición y depuración de código de aplicaciones C++/CLI con .NET Framework.","category":"Compiladores, herramientas de compilación y entornos de ejecución"},{"language":"fr-fr","title":"Prise en charge de C++/CLI pour Build Tools v141 (14.16)","description":"Outils et frameworks nécessaires pour modifier le code et déboguer les applications C++/CLI à l'aide du .NET Framework.","category":"Compilateurs, outils de génération et runtime"},{"language":"it-it","title":"Supporto C++/CLI per Build Tools v141 (14.16)","description":"Strumenti e framework necessari per la modifica del codice e il debug di applicazioni C++/CLI con .NET Framework.","category":"Compilatori, strumenti di compilazione e runtime"},{"language":"ja-jp","title":"v141 ビルド ツール (14.16) の C++/CLI サポート","description":".NET Framework を使用して C++/CLI アプリケーションのコード編集やデバッグを行うために必要なツールとフレームワーク。","category":"コンパイラ、ビルド ツール、およびランタイム"},{"language":"ko-kr","title":"v141 빌드 도구용 C++/CLI 지원(14.16)","description":".NET Framework를 사용한 C++/CLI 애플리케이션 디버깅 및 코드 편집을 위해 필요한 도구 및 프레임워크입니다.","category":"컴파일러, 빌드 도구 및 런타임"},{"language":"pl-pl","title":"Obsługa C++/CLI dla narzędzi kompilacji w wersji 141 (14.16)","description":"Wymagane narzędzia i platformy na potrzeby edytowania kodu i debugowania aplikacji C++/CLI przy użyciu platformy .NET Framework.","category":"Kompilatory, narzędzia do kompilacji i środowiska uruchomieniowe"},{"language":"pt-br","title":"Suporte ao C++/CLI para as ferramentas de build v141 (14.16)","description":"As ferramentas e as estruturas necessárias para depurar e editar o código de aplicativos C++/CLI usando o .NET Framework.","category":"Compiladores, ferramentas de build e tempos de execução"},{"language":"ru-ru","title":"Поддержка C++/CLI для средств сборки версии 141 (14.16)","description":"Необходимые инструменты и платформы для редактирования кода и отладки приложений на C++ и консольных приложений, использующих платформу .NET Framework.","category":"Компиляторы, средства сборки и среды выполнения"},{"language":"tr-tr","title":"v141 derleme araçları (14.16) için C++/CLI desteği","description":".NET Framework kullanarak C++/CLI uygulamalarında kod düzenleme ve hata ayıklama işlemleri yapmak için gereken araçlar ve çerçeveler.","category":"Derleyiciler, derleme araçları ve çalışma zamanları"}]},{"id":"Microsoft.VisualStudio.Component.VC.v141.MFC","version":"17.13.35710.127","type":"Component","automaticallyAddedByExtensionPack":false,"dependencies":{"Microsoft.VisualStudio.Component.VC.v141.ATL":"[17.0,18.0)","Microsoft.VisualC.14.16.MFC.Headers":"[14.0,18.0)","Micros