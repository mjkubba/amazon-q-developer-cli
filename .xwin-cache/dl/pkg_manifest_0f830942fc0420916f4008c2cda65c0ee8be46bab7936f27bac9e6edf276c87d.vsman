"localizedResources":[{"language":"en-us","title":"Office/SharePoint development","description":"Create Office and SharePoint add-ins, SharePoint solutions, and VSTO add-ins using C#, VB, and JavaScript.","category":"Other Toolsets","keywords":["add-in","Word","PowerPoint","Outlook","Excel","VSTO","web","add","ODT"]},{"language":"zh-cn","title":"Office/SharePoint 开发","description":"使用 C#、VB 和 JavaScript 创建 Office 和 SharePoint 外接程序、SharePoint 解决方案和 VSTO 外接程序。","category":"其他工具集","keywords":["外接程序","Word","PowerPoint","Outlook","Excel","VSTO","Web","添加","ODT"]},{"language":"zh-tw","title":"Office/SharePoint 開發","description":"使用 C#、VB 及 JavaScript 建立 Office 與 SharePoint 增益集、SharePoint 解決方案，以及 VSTO 增益集。","category":"其他工具組","keywords":["增益集","Word","PowerPoint","Outlook","Excel","VSTO","web","新增","ODT"]},{"language":"cs-cz","title":"Vývoj pro Office/SharePoint","description":"Vytvářejte doplňky pro Office a SharePoint, řešení pro SharePoint a doplňky pro VSTO pomocí C#, VB a JavaScriptu.","category":"Další sady nástrojů","keywords":["doplněk","Word","PowerPoint","Outlook","Excel","VSTO","web","přidat","ODT"]},{"language":"de-de","title":"Office-/SharePoint-Entwicklung","description":"Erstellen Sie Office- und SharePoint-Add-Ins, SharePoint-Lösungen und VSTO-Add-Ins mithilfe von C#, VB und JavaScript.","category":"Andere Toolsets","keywords":["Add-In","Word","PowerPoint","Outlook","Excel","VSTO","web","Hinzufügen","ODT"]},{"language":"es-es","title":"Desarrollo de Office y SharePoint","description":"Cree complementos de Office y SharePoint, soluciones de SharePoint y complementos VSTO mediante C#, VB y JavaScript.","category":"Otros conjuntos de herramientas","keywords":["complemento","Word","PowerPoint","Outlook","Excel","VSTO","web","agregar","ODT"]},{"language":"fr-fr","title":"Développement Office/SharePoint","description":"Créez des compléments Office et SharePoint, des solutions SharePoint, ainsi que des compléments VSTO en C#, VB et JavaScript.","category":"Autres