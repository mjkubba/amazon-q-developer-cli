C.14.38.17.8.MFC.Headers":"[14.0,18.0)","Microsoft.VC.14.38.17.8.MFC.MBCS.Spectre":"[14.0,18.0)","Microsoft.VC.14.38.17.8.MFC.MBCS.x64.Spectre":"[14.0,18.0)","Microsoft.VC.14.38.17.8.MFC.Redist.X64.Spectre":"[14.0,18.0)","Microsoft.VC.14.38.17.8.MFC.Redist.X86.Spectre":"[14.0,18.0)","Microsoft.VC.14.38.17.8.MFC.Source":"[14.0,18.0)","Microsoft.VC.14.38.17.8.MFC.x64.Spectre":"[14.0,18.0)","Microsoft.VC.14.38.17.8.MFC.x86.Spectre":"[14.0,18.0)","Microsoft.VisualStudio.VC.Ide.MFC_-104079356":{"id":"Microsoft.VisualStudio.VC.Ide.MFC","version":"[17.0,18.0)","when":["Microsoft.VisualStudio.Product.Enterprise","Microsoft.VisualStudio.Product.Professional","Microsoft.VisualStudio.Product.Community"]},"Microsoft.VisualCpp.HTMLHelpWorkshop.Msi":"[4.0,5.0)"},"localizedResources":[{"language":"en-us","title":"C++ v14.38 (17.8) MFC for v143 build tools with Spectre Mitigations (x86 & x64)","description":"Includes headers and libraries with Spectre Mitigations for the development of ATL and MFC applications including the Multi-byte Character Set (MBCS). End of support: July 2025.","category":"SDKs, libraries, and frameworks"},{"language":"zh-cn","title":"带有 Spectre 缓解措施且适用于 v143 生成工具的 C++ v14.38 (17.8) MFC (x86 和 x64)","description":"包括带有 Spectre 缓解措施的标头和库，用于开发包含多字节字符集(MBCS)的 ATL 和 MFC 应用程序。终止支持: 2025 年 7 月。","category":"SDK、库和框架"},{"language":"zh-tw","title":"適用於 v143 建置工具的 C++ v14.38 (17.8) MFC (Spectre 風險已降低) (x86 和 x64)","description":"包含用於開發 MFC 應用程式的標頭與程式庫及 Spectre 風險降低，包含以 ALT 和 ARM 為目標的多位元組字元集 (MBCS)。終止支援: 2025 年 7 月。","category":"SDK、程式庫和架構"},{"language":"cs-cz","title":"C++ v14.38 (17.8) MFC pro nástroje sestavení v143 se zmírněními hrozeb Spectre (x86 a x64)","description":"Obsahuje hlavičky a knihovny se zmírněními hrozeb Spectre pro vývoj aplikací ATL a MFC, včetně vícebajtové znakové sady (MBCS). Konec podpory: červenec 2025.","category":"Sady SDK, knihovny a architektury"},{"language":"de-de","title":"C++ v14.38 (17.8) MFC für v143-Buildtools mit Spectre-Entschärfungen (x86 und x64)","description":"Umfasst Header und Bibliotheken mit Spectre-Entschärfungen für die Entwicklung von ATL- und MFC-Anwendungen einschließlich Multibyte-Zeichensatz (MBCS). Ende des Supports: Juli 2025.","category":"SDKs, Bibliotheken und Frameworks"},{"language":"es-es","title":"Herramientas de compilación MFC para v143 de C++ v14.38 (17.8) con mitigaciones de Spectre (x86 y x64)","description":"Incluye encabezados y bibliotecas con mitigaciones de Spectre para el desarrollo de aplicaciones ATL y MFC, incluido el juego de caracteres multibyte (MBCS). Finalización del soporte: julio de 2025.","category":"SDK, bibliotecas y marcos"},{"language":"fr-fr","title":"C++ v14.38 (17.8) MFC pour les outils de génération v143 avec Spectre Mitigations (x86 et x64)","description":"Inclut des en-têtes et des bibliothèques avec atténuations Spectre pour le développement d'applications ATL et MFC, notamment le jeu de caractères multioctets (MBCS). Fin du support : juillet 2025.","category":"SDK, bibliothèques et frameworks"},{"language":"it-it","title":"MFC C++ v14.38 (17.8) per strumenti di compilazione v143 con mitigazioni Spectre (x86 & x64)","description":"Include intestazioni e librerie con mitigazioni Spectre per lo sviluppo di applicazioni ATL e MFC, incluso il set di caratteri multibyte (MBCS). Fine del supporto: luglio 2025.","category":"SDK, librerie e framework"},{"language":"ja-jp","title":"Spectre 軽減策を備えた v143 ビルド ツール用 C++ v14.38 (17.8) MFC (x86 および x64)","description":"マルチ バイト文字セット (MBCS) を含む ATL および MFC アプリケーションを開発するための、Spectre の軽減策を含むヘッダーとライブラリが含まれます。サポート終了日: 2025 年 7 月。","category":"SDK、ライブラリ、およびフレームワーク"},{"language":"ko-kr","title":"C++ v14.38(17.8) Spectre Mitigations(x86 및 x64)가 포함된 v143 빌드 도구용 MFC","description":"MBCS(멀티바이트 문자 집합)를 비롯하여 ATL 및 MFC 애플리케이션 개발을 위한 Spectre 완화 기능을 사용하는 헤더와 라이브러리를 포함합니다. 지원 종료일: 2025년 7월.","category":"SDK, 라이브러리 및 프레임워크"},{"language":"pl-pl","title":"Klasy MFC języka C++ v14.38 (17.8) dla narzędzi kompilacji v143 z ograniczeniami ryzyka luki Spectre (x86 i x64)","description":"Zawiera nagłówki i biblioteki ze środkami zaradczymi dla luki Spectre na potrzeby programowania aplikacji ATL i MFC, łącznie z wielobajtowym zestawem znaków (MBCS). Koniec wsparcia technicznego: lipiec 2025 r.","category":"Zestawy SDK, biblioteki i struktury"},{"language":"pt-br","title":"C++ v14.38 (17.8) MFC para ferramentas de compilação v143 com Spectre Mitigations (x86 e x64)","description":"Inclui cabeçalhos e bibliotecas com Mitigações do Spectre para o desenvolvimento de aplicativos ATL e MFC, incluindo o Conjunto de Caracteres Multibyte (MBCS). Fim do suporte: julho de 2025.","category":"SDKs, bibliotecas e estruturas"},{"language":"ru-ru","title":"MFC-библиотека C++ версии 14.38 (17.8) для средств сборки версии 143 с устранением рисков Spectre (x86 и x64)","description":"Включает заголовки и библиотеки с устранением рисков Spectre для разработки приложений ATL и MFC, включая многобайтовую кодировку (MBCS). Окончание поддержки: июль 2025 г.","category":"Пакеты SDK, библиотеки и платформы"},{"language":"tr-tr","title":"Spectre Risk Azaltmaları (x86 & x64) içeren v143 derleme araçları için C++ v14.38 (17.8) MFC","description":"Çok Baytlı Karakter Kümesi (MBCS) dahil olmak üzere ATL ve MFC uygulamaları geliştirmeye yönelik Spectre Risk Azaltmalarının bulunduğu üst bilgileri ve kitaplıkları içerir. Destek sonu: Temmuz 2025.","category":"SDK'lar, kitaplıklar ve çerçeveler"}]},{"id":"Microsoft.VisualStudio.Component.VC.14.38.17.8.x86.x64","version":"17.13.35710.127","type":"Component","automaticallyAddedByExtensionPack":false,"dependencies":{"Microsoft.VisualStudio.VC.MSBuild.v170.x64.v143":"[17.0,18.0)","Microsoft.VisualStudio.VC.MSBuild.v170.x86.v143":"[17.0,18.0)","Microsoft.VS.VC.vcvars.X64.Shortcuts":"[17.0,18.0)","Microsoft.VS.VC.vcvars.X86.Shortcuts":"[17.0,18.0)","Microsoft.VisualStudio.VC.vcvars":"[17.0,18.0)","Microsoft.VisualCpp.Redist.14.Latest":"[14.0,18.0)","Microsoft.VisualCpp.Redist.14":