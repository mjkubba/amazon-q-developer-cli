ity"},{"language":"de-de","title":"C++-Tools für Linux-Entwicklung","description":"Visual Studio Build Tools für die C++ Linux-Entwicklung für Server, Desktops und Geräte wie Raspberry Pi.","category":"Entwicklungsaktivitäten"},{"language":"es-es","title":"Herramientas de C++ para el desarrollo de Linux","description":"Visual Studio Build Tools para el desarrollo de Linux en C++, funciona para servidores, escritorios y dispositivos como Raspberry Pi.","category":"Actividades de desarrollo"},{"language":"fr-fr","title":"Outils C++ pour le développement Linux","description":"Visual Studio Build Tools pour le développement Linux C++, fonctionne pour les serveurs, les ordinateurs de bureau et les appareils tels que Raspberry Pi.","category":"Activités de développement"},{"language":"it-it","title":"Strumenti C++ per lo sviluppo di applicazioni Linux","description":"L'estensione di Visual Studio Build Tools per lo sviluppo di applicazioni Linux con C++ funziona con server, desktop e dispositivi come Raspberry Pi.","category":"Attività di sviluppo"},{"language":"ja-jp","title":"C++ Tools for Linux Development","description":"Visual Studio Build Tools for C++ Linux Development。サーバー、デスクトップ、Raspberry Pi などのデバイスで動作します。","category":"開発作業"},{"language":"ko-kr","title":"Linux 개발을 위한 C++ 도구","description":"C++ Linux 개발용 Visual Studio Build Tools는 서버, 데스크톱 및 Raspberry Pi와 같은 장치에서 작동합니다.","category":"개발 작업"},{"language":"pl-pl","title":"Narzędzia języka C++ do programowania w systemie Linux","description":"Oprogramowanie Visual Studio Build Tools do tworzenia aplikacji w języku C++ dla systemu Linux, działa na serwerach, komputerach stacjonarnych i urządzeniach takich jak Raspberry Pi.","category":"Działania programistyczne"},{"language":"pt-br","title":"Ferramentas do C++ para desenvolvimento em Linux","description":"Ferramentas de Build do Visual Studio para desenvolvimento em C++ para Linux, funciona para servidores, áreas de trabalho e dispositivos como o Raspberry PI.","category":"Atividades de desenvolvimento"},{"language":"ru-ru","title":"Инструменты C++ для разработки приложений Linux","description":"Инструменты Visual Studio Build Tools для разработки приложений Linux на языке C++ предназначены для серверов, компьютеров и устройств, например Raspberry Pi.","category":"Действия разработки"},{"language":"tr-tr","title":"Linux Geliştirme için C++ Araçları","description":"C++ Linux geliştirme için Visual Studio Derleme Araçları; sunucular, masaüstü bilgisayarlar ve Raspberry Pi gibi cihazlarda çalışır.","category":"Geliştirme etkinlikleri"}]},{"id":"Microsoft.VisualStudio.Workload.ManagedDesktop","version":"17.13.35710.127","type":"Workload","productArch":"arm64","icon":{"mimeType":"image/svg+xml","base64":""},"dependencies":{"Microsoft.VisualStudio.Component.ManagedDesktop.Prerequisites":"[17.0,18.0)","Microsoft.Net.ComponentGroup.DevelopmentPrerequisites":"[17.0,18.0)","Microsoft.VisualStudio.Component.Roslyn.LanguageServices":"[17.0,18.0)","Microsoft.VisualStudio.PackageGroup.Interactive":"[17.0,18.0)","Microsoft.NetCore.Component.DevelopmentTools":{"version":"[17.0,18.0)","type":"Recommended"},"Microsoft.Net.ComponentGroup.4.8.DeveloperTools":{"version":"[17.0,18.0)","type":"Recommended"},"Microsoft.VisualStudio.Component.EntityFramework":{"version":"[17.0,18.0)","type":"Recommended"},"Microsoft.VisualStudio.Component.DiagnosticTools":{"version":"[17.0,18.0)","type":"Recommended"},"Microsoft.VisualStudio.Component.IntelliCode":{"version":"[17.0,18.0)","type":"Recommended"},"Microsoft.VisualStudio.Component.IntelliTrace.FrontEnd_1779377902":{"id":"Microsoft.VisualStudio.Component.IntelliTrace.FrontEnd","version":"[17.0,18.0)","type":"Recommended","when":["Microsoft.VisualStudio.Product.EnterpriseX86","Microsoft.VisualStudio.Product.Enterprise"]},"Microsoft.VisualStudio.Component.Debugger.JustInTime":{"version":"[17.0,18.0)","type":"Recommended"},"Microsoft.VisualStudio.Component.LiveUnitTesting_1779377902":{"id":"Microsoft.VisualStudi