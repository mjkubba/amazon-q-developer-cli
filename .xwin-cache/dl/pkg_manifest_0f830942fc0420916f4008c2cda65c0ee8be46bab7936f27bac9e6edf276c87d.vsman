x","signer":{"$ref":"1"}}],"installSizes":{"targetDrive":812181},"fileAssociations":[{"extension":".xamlx","progId":"VisualStudio.xamlx.[InstanceId]","defaultProgramRegistrationPath":"Software\\Microsoft\\VisualStudio_[InstanceId]\\Capabilities"}],"progIds":[{"id":"VisualStudio.xamlx.[InstanceId]","displayName":"Workflow Service File","alwaysShowExtension":true,"path":"[InstallDir]\\Common7\\IDE\\devenv.exe","defaultIconPath":"[InstallDir]\\Common7\\IDE\\Microsoft.VisualStudio.Activities.dll","defaultIconPosition":-100,"dde":true,"ddeApplication":"VisualStudio.17.0","ddeTopic":"system"}]},{"id":"Microsoft.VisualStudio.Workload.Azure","version":"17.13.35710.127","type":"Workload","icon":{"mimeType":"image/svg+xml","base64":""},"dependencies":{"Microsoft.VisualStudio.ComponentGroup.Azure.Prerequisites":"[17.0,18.0)","Microsoft.Net.ComponentGroup.DevelopmentPrerequisites":"[17.0,18.0)","Microsoft.VisualStudio.Component.Web":"[17.0,18.0)","Microsoft.VisualStudio.Component.DockerTools":"[17.0,18.0)","Microsoft.VisualStudio.KeychainCredentialHelper":"[16.0,18.0)","Microsoft.Net.ComponentGroup.4.8.DeveloperTools":{"version":"[17.0,18.0)","type":"Recommended"},"Microsoft.VisualStudio.Component.AspNet_341893570":{"id":"Microsoft.VisualStudio.Component.AspNet","version":"[17.0,18.0)","type":"Recommended","when":["Microsoft.VisualStudio.Product.ProfessionalX86","Microsoft.VisualStudio.Product.Professional","Microsoft.VisualStudio.Product.EnterpriseX86","Microsoft.VisualStudio.Product.Enterprise"]},"Microsoft.Component.Azure.DataLake.Tools":{"version":"[17.0,18.0)","type":"Recommended"},"Microsoft.VisualStudio.ComponentGroup.Azure.ResourceManager.Tools":{"version":"[17.0,18.0)","type":"Recommended"},"Microsoft.VisualStudio.ComponentGroup.Azure.CloudServices":{"version":"[17.0,18.0)","type":"Recommended"},"Microsoft.VisualStudio.Component.Azure.ServiceFabric.Tools":{"version":"[17.0,18.0)","type":"Recommended"},"Microsoft.VisualStudio.Component.Debugger.Snapshot_1779377902":{"id":"Microsoft.VisualStudio.Component.Debugger.Snapshot","version":"[17.0,18.0)","type":"Recommended","when":["Microsoft.VisualStudio.Product.EnterpriseX86","Microsoft.VisualStudio.Product.Enterprise"]},"Microsoft.VisualStudio.Component.Azure.Powershell":{"version":"[17.0,18.0)","type":"Optional"},"Microsoft.VisualStudio.Component.IntelliCode":{"version":"[17.0,18.0)","type":"Recommended"},"Component.VisualStudio.GitHub.Copilot":{"version":"","type":"Recommended"},"Microsoft.VisualStudio.Component.AspNet_-1867733407":{"id":"Microsoft.VisualStudio.Component.AspNet","version":"[17.0,18.0)","type":"Optional","when":["Microsoft.VisualStudio.Product.CommunityX86","Microsoft.VisualStudio.Product.Community"]},"Microsoft.VisualStudio.Component.Wcf.Tooling":{"version":"[17.0,18.0)","type":"Optional"},"Microsoft.Net.ComponentGroup.4.6.2-4.7.1.DeveloperTools":{"version":"[17.0,18.0)","type":"Optional","behaviors":"IgnoreApplicabilityFailures"},"Microsoft.Net.ComponentGroup.4.8.1.DeveloperTools":{"version":"[17.0,18.0)","type":"Optional","behaviors":"IgnoreApplicabilityFailures"}},"localizedResources":[{"language":"en-us","title":"Azure development","description":"Azure SDKs, tools, and projects for developing cloud apps and creating resources using .NET and .NET Framework. Also includes tools for containerizing your application, including Docker support.","longDescription":"Azure SDKs, tools, and projects for developing cloud apps and creating resources using .NET and .NET Framework. Also includes tools for containerizing your application, including Docker support.","category":"Web & Cloud"},{"language":"zh-cn","title":"Azure 开发","description":"用于使用 .NET 和 .NET Framework 开发云应用和创建资源的 Azure SDK、工具和项目。还包含用于实现应用程序容器化的工具，包括 Docker 支持。","longDescription":"用于使用 .NET 和 .NET Framework 开发云应用和创建资源的 Azure SDK、工具和项目。还包含用于实现应用程序容器化的工具，包括 Docker 支持。","category":"Web 和云"},{"language":"zh-tw","title":"Azure 開發","description":"用於使用 .NET 和 .NET Framework 開發雲端應用程式及建立資源的 Azure SDK、工具及專案。同時包含用於將應用程式容器化的工具，包括 Docker 支援。","longDescription":"用於使用 .NET 和 .NET Framework 開發雲端應用程式及建立資源的 Azure SDK、工具及專案。同時包含用於將應用程式容器化的工具，包括 Docker 支援。","category":"Web 與雲端"},{"language":"cs-cz","title":"Azure – vývoj","description":"Azure SDK, nástroje a projekty pro vývoj cloudových aplikací a vytváření prostředků pomocí .NET a .NET Framework. Zahrnuje také nástroje pro uzavření aplikace do kontejneru včetně podpory Dockeru.","longDescription":"Azure SDK, nástroje a projekty pro vývoj cloudových aplikací a vytváření prostředků pomocí .NET a .NET Framework. Zahrnuje také nástroje pro uzavření aplikace do kontejneru včetně podpory Dockeru.","category":"Web a cloud"},{"language":"de-de","title":"Azure-Entwicklung","description":"Azure SDKs, Tools und Projekte für die Entwicklung von Cloud-Apps und das Erstellen von Ressourcen mit .NET und .NET Framework. Ebenfalls enthalten sind Tools zur Umstellung Ihrer Anwendung auf Container, darunter Unterstützung für Docker.","longDescription":"Azure SDKs, Tools und Projekte für die Entwicklung von Cloud-Apps und das Erstellen von Ressourcen mit .NET und .NET Framework. Ebenfalls enthalten sind Tools zur Umstellung Ihrer Anwendung auf Container, darunter Unterstützung für Docker.","category":"Web und Cloud"},{"language":"es-es","title":"Desarrollo de Azure","description":"Proyectos, herramientas y SDK de Azure para desarrollar aplicaciones en la nube y crear recursos mediante .NET y .NET Framework. Cuenta también con herramientas para incluir la aplicación en contenedores, además de ofrecer compatibilidad con Docker.","longDescription":"Proyectos, herramientas y SDK de Azure para desarrollar aplicaciones en la nube y crear recursos mediante .NET y .NET Framework. Cuenta también con herramientas para incluir la aplicación en contenedores, además de ofrecer compatibilidad con Docker.","category":"Web y nube"},{"language":"fr-fr","title":"Développement Azure","description":"Kits Azure SDK, outils et projets pour le développement d'applications cloud et la création de ressources à l'aide de .NET et .NET Framework. Comprend également des outils pour conteneuriser votre application en incluant notamment la prise en charge de Docker.","longDescription":"Kits Azure SDK, outils et projets pour le développement d'applications cloud et la création de ressources à l'aide de .NET et .NET Framework. Comprend également des outils pour conteneuriser votre application en incluant notamment la prise en charge de Docker.","category":"Web et cloud"},{"language":"it-it","title":"Sviluppo di Azure","description":"SDK di Azure, strumenti e progetti per sviluppare app cloud e creare risorse usando .NET e .NET Framework. Include anche strumenti per la containerizzazione delle applicazioni, incluso il supporto Docker.","longDescription":"SDK di Azure, strumenti e progetti per sviluppare app cloud e creare risorse usando .NET e .NET Framework. Include anche strumenti per la containerizzazione delle applicazioni, incluso il supporto Docker.","category":"Web e cloud"},{"language":"ja-jp","title":"Azure の開発","description":".NET および .NET Framework を使用したクラウド アプリ開発とリソース作成のための Azure SDK、ツール、プロジェクトです。また、Docker のサポートを含め、アプリケーションをコンテナー化するツールも含まれます。","longDescription":".NET および .NET Framework を使用したクラウド アプリ開発とリソース作成のための Azure SDK、ツール、プロジェクトです。また、Docker のサポートを含め、アプリケーションをコンテナー化するツールも含まれます。","category":"Web & クラウド"},{"language":"ko-kr","title":"Azure 개발","description":".NET 및 .NET Framework를 사용하여 클라우드 앱을 개발하고 리소스를 만들기 위한 Azure SDK, 도구 및 프로젝트입니다. Docker 지원을 비롯하여, 애플리케이션을 컨테이너화하기 위한 도구도 포함됩니다.","longDescription":".NET 및 .NET Framework를 사용하여 클라우드 앱을 개발하고 리소스를 만들기 위한 Azure SDK, 도구 및 프로젝트입니다. Docker 지원을 비롯하여, 애플리케이션을 컨테이너화하기 위한 도구도 포함됩니다.","category":"웹 및 클라우드"},{"language":"pl-pl","title":"Programowanie na platformie Azure","description":"Zestawy SDK, narzędzia i projekty platformy Azure do tworzenia aplikacji w chmurze i zasobów za pomocą platform .NET Core i .NET Framework. Obejmuje to również narzędzia do umieszczania aplikacji w kontenerze, w tym obsługę platformy Docker.","longDescription":"Zestawy SDK, narzędzia i projekty platformy Azure do tworzenia aplikacji w chmurze i zasobów za pomocą platform .NET Core i .NET Framework. Obejmuje to również narzędzia do umieszczania aplikacji w kontenerze, w tym obsługę platformy Docker.","category":"Sieć Web i chmura"},{"language":"pt-br","title":"Desenvolvimento para Azure","description":"SDKs, ferramentas e projetos do Azure para desenvolver aplicativos na nuvem e criar recursos usando o .NET e o .NET Framework. Também inclui ferramentas para conteinerizar seu aplicativo, incluindo o suporte a Docker.","longDescription":"SDKs, ferramentas e projetos do Azure para desenvolver aplicativos na nuvem e criar recursos usando o .NET e o .NET Framework. Também inclui ferramentas para conteinerizar seu aplicativo, incluindo o suporte a Docker.","category":"Web e Nuvem"},{"language":"ru-ru","title":"Разработка для Azure","description":"Пакеты SDK Azure, средства и проекты для разработки облачных приложений и создания ресурсов с использованием .NET и .NET Framework. Также содержит инструменты для контейнеризации приложения, включая поддержку Docker.","longDescription":"Пакеты SDK Azure, средства и проекты для разработки облачных приложений и создания ресурсов с использованием .NET и .NET Framework. Также содержит инструменты для контейнеризации приложения, включая поддержку Docker.","category":"Веб-разработка и облако"},{"language":"tr-tr","title":"Azure geliştirme","description":".NET ve .NET Framework ile bulut uygulamaları geliştirmek ve kaynak oluşturmak için kullanılan Azure SDK'ları, araçları ve projeleri. Ayrıca Docker desteği dahil olmak üzere uygulamanızı kapsayıcılı hale getirmek için kullanılan araçlar içerir.","longDescription":".NET ve .NET Framework ile bulut uygulamaları geliştirmek ve kaynak oluşturmak için kullanılan Azure SDK'ları, araçları ve projeleri. Ayrıca Docker desteği dahil olmak üzere uygulamanızı kapsayıcılı hale getirmek için kullanılan araçlar içerir.","category":"Web ve Bulut"}]},{"id":"Microsoft.VisualStudio.Workload.AzureBuildTools","version":"17.13.35710.127","type":"Workload","icon":{"mimeType":"image/svg+xml","base64":""},"dependencies":{"Microsoft.VisualStudio.Wcf.BuildTools.ComponentGroup":"[17.0,18.0)","Microsoft.VisualStudio.Web.BuildTools.ComponentGroup":"[17.0,18.0)","Microsoft.Net.ComponentGroup.DevelopmentPrerequisites":"[17.0,18.0)","Microsoft.VisualStudio.Component.Azure.Waverton.BuildTools":"[17.0,18.0)","Microsoft.VisualStudio.Component.DockerTools.BuildTools":"[17.0,18.0)","Microsoft.VisualStudio.Component.TypeScript.TSServer":"[17.0,18.0)","Microsoft.Net.ComponentGroup.4.8.DeveloperTools":{"version":"[17.0,18.0)","type":"Recommended"},"Microsoft.VisualStudio.Component.AspNet_341893570":{"id":"Microsoft.VisualStudio.Component.AspNet","version":"[17.0,18.0)","type":"Recommended","when":["Microsoft.VisualStudio.Product.ProfessionalX86","Microsoft.VisualStudio.Product.Professional","Microsoft.VisualStudio.Product.EnterpriseX86","Microsoft.VisualStudio.Product.Enterprise"]},"Microsoft.VisualStudio.Component.NuGet.BuildTools":{"version":"[17.0,18.0)","type":"Recommended"},"Microsoft.VisualStudio.Component.WebDeploy":{"version":"[17.0,18.0)","type":"Recommended"},"Microsoft.VisualStudio.Component.AspNet_-1867733407":{"id":"Microsoft.VisualStudio.Component.AspNet","version":"[17.0,18.0)","type":"Optional","when":["Microsoft.VisualStudio.Product.CommunityX86","Microsoft.VisualStudio.Product.Community"]},"Microsoft.Net.Component.3.5.DeveloperTools":{"version":"[17.0,18.0)","type":"Optional","behaviors":"IgnoreApplicabilityFailures"},"Microsoft.Net.ComponentGroup.4.6.2-4.7.1.DeveloperTools":{"version":"[17.0,18.0)","type":"Optional","behaviors":"IgnoreApplicabilityFailures"},"Microsoft.NetCore.Component.SDK":{"version":"[17.0,18.0)","type":"Optional"},"Microsoft.Net.ComponentGroup.4.8.1.DeveloperTools":{"version":"[17.0,18.0)","type":"Optional","behaviors":"IgnoreApplicabilityFailures"}},"localizedResources":[{"language":"en-us","title":"Azure development build tools","description":"MSBuild tasks and targets for building Azure applications.","category":"Web & Cloud"},{"language":"zh-cn","title":"Azure 开发生成工具","description":"用于生成 Azure 应用程序的 MSBuild 任务和目标。","category":"Web 和云"},{"language":"zh-tw","title":"Azure 開發建置工具","description":"用於 Azure 應用程式的 MSBuild 工作及應用程式的目標。","category":"Web 與雲端"},{"language":"cs-cz","title":"Nástroje pro vytváření a vývoj pro Azure","description":"Úlohy a cíle platformy MSBuild pro vytváření aplikací Azure","category":"Web a cloud"},{"language":"de-de","title":"Buildtools zur Azure-Entwicklung","description":"MSBuild-Aufgaben und -Ziele für das Erstellen von Azure-Anwendungen.","category":"Web und Cloud"},{"language":"es-es","title":"Herramientas de compilación de desarrollo para Azure","description":"Tareas y destinos de MSBuild para la compilación de aplicaciones para Azure.","category":"Web y nube"},{"language":"fr-fr","title":"Outils de build pour le développement Azure","description":"Tâches et cibles MSBuild pour la génération d'applications Azure.","category":"Web et cloud"},{"language":"it-it","title":"Strumenti di compilazione sviluppo di Azure","description":"Attività e destinazioni MSBuild per la creazione di applicazioni Azure.","category":"Web e cloud"},{"language":"ja-jp","title":"Azure 開発ビルド ツール","description":"Azure アプリケーションのビルドのための MSBuild タスクとターゲット。","category":"Web & クラウド"},{"language":"ko-kr","title":"Azure 개발 빌드 도구","description":"Azure 애플리케이션을 빌드하기 위한 MSBuild 작업 및 대상입니다.","category":"웹 및 클라우드"},{"language":"pl-pl","title":"Deweloperskie narzędzia do kompilacji dla platformy Azure","description":"Zadania i elementy docelowe programu MSBuild służące do tworzenia aplikacji platformy Azure.","category":"Sieć Web i chmura"},{"language":"pt-br","title":"Ferramentas de build de desenvolvimento do Azure","description":"Tarefas e destinos MSBuild para criação de aplicativos do Azure.","category":"Web e Nuvem"},{"language":"ru-ru","title":"Средства сборки и разработки Azure","description":"Задачи и целевые объекты MSBuild для сборки приложений Azure.","category":"Веб-разработка и облако"},{"language":"tr-tr","title":"Web geliştirme derleme araçları","description":"Azure uygulamaları oluşturmaya yönelik MSBuild görevleri ve hedefleri.","category":"Web ve Bulut"}]},{"id":"Microsoft.VisualStudio.Workload.CoreEditor","version":"17.13.35710.127","type":"Workload","icon":{"mimeType":"image/svg+xml","base64":""},"dependencies":{"Microsoft.VisualStudio.Component.CoreEditor":"[17.0,18.0)"},"localizedResources":[{"language":"en-us","title":"Visual Studio core editor","description":"The Visual Studio core shell experience, including syntax-aware code editing, source code control and work item management."},{"language":"zh-cn","title":"Visual Studio 核心编辑器","description":"Visual Studio 核心 shell 体验，包括语法感知代码编辑器、源代码管理和工作项管理。"},{"language":"zh-tw","title":"Visual Studio 核心編輯器","description":"Visual Studio 核心殼層體驗，包括語法感知程式碼編輯、原始程式碼控制及工作項目管理。"},{"language":"cs-cz","title":"Základní editor Visual Studio","description":"Základní možnosti a prostředí sady Visual Studio, včetně úprav kódu podle syntaxe, správy zdrojového kódu a správy pracovních položek"},{"language":"de-de","title":"Visual Studio-Kern-Editor","description":"Die Shell-Kernbenutzeroberfläche von Visual Studio, die syntaxfähige Codebearbeitung, Quellcodeverwaltung und Arbeitselementverwaltung bereitstellt."},{"language":"es-es","title":"Editor de núcleo de Visual Studio","description":"La experiencia del shell principal de Visual Studio, que incluye edición de código compatible con la sintaxis, control de código fuente y administración de elementos de trabajo.\n"},{"language":"fr-fr","title":"Éditeur de base de Visual Studio","description":"Utilisation de l'interpréteur de commandes de base Visual Studio, modification du code avec prise en charge de la syntaxe, contrôle de code source et gestion des éléments de travail."},{"language":"it-it","title":"Editor principale di Visual Studio","description":"Shell di base di Visual Studio, che include un editor di codice con riconoscimento della sintassi, il controllo del codice sorgente e la gestione degli elementi di lavoro."},{"language":"ja-jp","title":"Visual Studio のコア エディター","description":"構文認識コード編集機能、ソース コード管理、作業項目管理などの Visual Studio の基本的なシェル エクスペリエンス。"},{"language":"ko-kr","title":"Visual Studio 핵심 편집기","description":"구문 인식 코드 편집, 소스 코드 제어, 작업 항목 관리 등을 포함하는 Visual Studio 코어 셸 환경입니다."},{"language":"pl-pl","title":" Visual Studio Core Editor","description":"Podstawowe funkcje powłoki programu Visual Studio, w tym edytowanie kodu z rozpoznawaniem składni, kontrola kodu źródłowego i zarządzanie elementami roboczymi."},{"language":"pt-br","title":"Editor de núcleo do Visual Studio","description":"A experiência do shell do núcleo do Visual Studio, incluindo edição de código com reconhecimento de sintaxe, controle de software livre e gerenciamento de item de trabalho."},{"language":"ru-ru","title":"Основной редактор Visual Studio","description":"Интерфейс оболочки ядра Visual Studio, включая редактирование кода с учетом синтаксиса, управление исходным кодом и рабочими элементами."},{"language":"tr-tr","title":"Visual Studio temel düzenleyicisi","description":"Visual Studio'nun, söz dizimine duyarlı kod düzenleme, kaynak kodu denetimi ve iş öğesi yönetimi gibi özellikler sunan, temel kabuk deneyimi."}]},{"id":"Microsoft.VisualStudio.Workload.Data","version":"17.13.35710.127","type":"Workload","icon":{"mimeType":"image/svg+xml","base64":""},"dependencies":{"Microsoft.VisualStudio.Component.SQL.SSDT":{"version":"[17.0,18.0)","type":"Recommended"},"Microsoft.Component.Azure.DataLake.Tools":{"version":"[17.0,18.0)","type":"Recommended"},"Microsoft.Net.ComponentGroup.DevelopmentPrerequisites":{"version":"[17.0,18.0)","type":"Recommended"},"Component.VisualStudio.GitHub.Copilot":{"version":"","type":"Recommended"},"Microsoft.VisualStudio.Component.FSharp.Desktop":{