af819a438bdf72a3ac90f928bf60ae99b57f313/payload.vsix","signer":{"$ref":"1"}}],"installSizes":{"targetDrive":5046405}},{"id":"Microsoft.Net.Core.Component.SDK.2.1","version":"17.13.35710.127","type":"Component","automaticallyAddedByExtensionPack":false,"outOfSupport":true,"dependencies":{"Microsoft.AspNetCore.SharedFramework.2.1.2.1.30":"[17.0,18.0)","Microsoft.NetCore.SharedFramework.2.1.2.1.30":"[17.0,18.0)","Microsoft.NetCore.Templates.2.1.8.0.200-rtm.24069.25":"[17.0,18.0)"},"localizedResources":[{"language":"en-us","title":".NET Core 2.1 Runtime (Out of support)","description":"Runtimes and templates for developing and running .NET Core 2.1 applications. This version is no longer supported and will not receive security updates.","category":".NET"},{"language":"zh-cn","title":".NET Core 2.1 运行时(不受支持)","description":"适用于开发和运行 .NET Core 2.1 应用程序的运行时和模板。此版本不再受支持，并且不会接收安全更新。","category":".NET"},{"language":"zh-tw","title":".NET Core 2.1 執行階段 (不支援)","description":"用於開發及執行 .NET Core 2.1 應用程式的執行階段及範本。此版本已不受支援，所以不會取得安全性更新。","category":".NET"},{"language":"cs-cz","title":"Modul runtime .NET Core 2.1 (bez podpory)","description":"Moduly runtime a šablony pro vývoj a spouštění aplikací .NET Core 2.1. Tato verze se už nepodporuje a nebude dostávat aktualizace zabezpečení.","category":".NET"},{"language":"de-de","title":".NET Core 2.1-Runtime (nicht mehr unterstützt)","description":"Runtimes und Vorlagen für das Entwickeln und Ausführen von .NET Core 2.1-Anwendungen. Diese Version wird nicht mehr unterstützt, und es werden keine Sicherheitsupdates mehr bereitgestellt.","category":".NET"},{"language":"es-es","title":"Entorno de ejecución de .NET Core 2.1 (no compatible)","description":"Runtime y plantillas para desarrollar y ejecutar aplicaciones de .NET Core 2.1. Esta versión ya no se admite y no recibirá actualizaciones de seguridad.","category":".NET"},{"language":"fr-fr","title":".NET Core 2.1 Runtime (hors prise en charge)","description":"Runtimes et modèles pour le développement et l'exécution d'applications .NET Core 2.1. Cette version n'est plus prise en charge et ne recevra pas de mises à jour de sécurité.","category":".NET"},{"language":"it-it","title":"Runtime di .NET Core 2.1 (supporto non disponibile)","description":"Runtime e modelli per lo sviluppo di applicazioni .NET Core 2.1. Questa versione non è più supportata e non riceverà più gli aggiornamenti per la sicurezza.","category":".NET"},{"language":"ja-jp","title":".NET Core 2.1 ランタイム (サポート対象外)","description":".NET Core 2.1 アプリケーションを開発および実行するためのランタイムおよびテンプレートです。このバージョンはサポートされなくなり、セキュリティ更新プログラムを受け取りません。","category":".NET"},{"language":"ko-kr","title":".NET Core 2.1 런타임(지원되지 않음)","description":".NET Core 2.1 애플리케이션을 개발 및 실행에 대한 런타임 및 서식 파일입니다. 이 버전은 더 이상 지원되지 않으며 보안 업데이트를 받지 못합니다.","category":".NET"},{"language":"pl-pl","title":"Środowisko uruchomieniowe platformy .NET Core 2.1 (brak pomocy technicznej)","description":"Środowisko uruchomieniowe i szablony tworzenia i uruchamiania aplikacji platformy .NET Core 2.1. W przypadku tej wersji nie jest już świadczona pomoc techniczna i nie będzie ona otrzymywać aktualizacji zabezpieczeń.","category":".NET"},{"language":"pt-br","title":"Runtime do .NET Core 2.1 (sem suporte)","description":"Tempos de execução e modelos para desenvolver e executar aplicativos .NET Core 2.1. Esta versão não é mais compatível e não receberá atualizações de segurança.","category":".NET"},{"language":"ru-ru","title":"Среда выполнения .NET Core 2.1 (не поддерживается)","description":"Среды выполнения и шаблоны для разработки и запуска приложений .NET Core 2.1. Эта версия больше не поддерживается и не будет получать обновления системы безопасности.","category":".NET"},{"language":"tr-tr","title":".NET Core 2.1 Çalışma Zamanı (Destek kapsamı dışında)","description":".NET Core 2.1 uygulamaları geliştirip çalıştırmaya yönelik çalışma zamanları ve şablonlar. Bu sürüm artık desteklenmediğinden güvenlik güncelleştirmelerini almayacak.","category":".NET"}]},{"i