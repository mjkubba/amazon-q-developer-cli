To":"MicrosoftAspNetCoreReference","priority":400}],"localizedResources":[{"language":"en-us","title":"ASP.NET and web development","description":"Build web applications using ASP.NET Core, ASP.NET, HTML/JavaScript, and Containers including Docker support.","longDescription":"Build web applications using ASP.NET Core, ASP.NET, and standards-based web technologies including HTML, JavaScript, CSS, and JSON.  Also includes tools for containerizing your application, including Docker support.","category":"Web & Cloud","keywords":["HTML","CSS","Javascript/JS","JS","Web","WebSite","Web Site","WebAPI","Web API","MVC","Razor","Web Forms","Web Pages","aspx","cshtml","vbhtml","ASP","Core",".NET","Typescript","Stylesheet","Azure","Bower","Npm","Aspire"]},{"language":"zh-cn","title":"ASP.NET 和 Web 开发","description":"使用 ASP.NET Core、ASP.NET、HTML/JavaScript 和包括 Docker 支持的容器生成 Web 应用程序。","longDescription":"使用 ASP.NET Core、ASP.NET 和基于标准的 Web 技术(包括 HTML、JavaScript、CSS 和 JSON)构建 Web 应用程序。还包含用于实现应用程序容器化的工具，包括 Docker 支持。","category":"Web 和云","keywords":["html","CSS","Javascript/JS","JS","Web","网站","网站","WebAPI","Web API","MVC","Razor","Web Forms","网页","aspx","cshtml","vbhtml","ASP","核心",".NET","Typescript","样式表","Azure","Bower","Npm","Aspire"]},{"language":"zh-tw","title":"ASP.NET 與網頁程式開發","description":"使用 ASP.NET Core、ASP.NET、HTML/JavaScript 及容器 (包括 Docker 支援) 建立 Web 應用程式。","longDescription":"使用 ASP.NET、 ASP.NET Core 及符合標準的網路技術 (包括 HTML、JavaScript、CSS 及 JSON) 建置 Web 應用程式， 並包含應用程式容器化的工具，包括 Docker 支援。","category":"Web 與雲端","keywords":["HTML","CSS","Javascript/JS","JS","Web","網站","網站","WebAPI","Web API","MVC","Razor","Web Forms","Web Pages","aspx","cshtml","vbhtml","ASP","核心",".NET","Typescript","樣式表","Azure","Bower","Npm","Aspire"]},{"language":"cs-cz","title":"Vývoj pro ASP.NET a web","description":"Umožňuje sestavovat webové aplikace pomocí technologií ASP.NET Core, ASP.NET, HTML/JavaScript a Containers včetně podpory Dockeru.","longDescription":"Umožňuje sestavovat webové aplikace pomocí technologií ASP.NET Core a ASP.NET a standardních webových technologií, jako jsou HTML, JavaScript, CSS a JSON. Obsahuje také nástroje pro uzavření aplikace do kontejneru včetně podpory Dockeru.","category":"Web a cloud","keywords":["HTML","CSS","Javascript/JS","JS","Web","Web","Web","WebAPI","Webové rozhraní API","MVC","Razor","Web Forms","Webové stránky","aspx","cshtml","vbhtml","ASP","Jádro",".NET","TypeScript","Šablona stylů","Azure","Bower","Npm","Aspire"]},{"language":"de-de","title":"ASP.NET und Webentwicklung","description":"Hiermit erstellen Sie Webanwendungen mit ASP.NET Core, ASP.NET, HTML/JavaScript und Containern, einschließlich Unterstützung für Docker.","longDescription":"Hiermit erstellen Sie Webanwendungen mit ASP.NET Core, ASP.NET und standardbasierten Webtechnologien wie z. B. HTML, JavaScript, CSS und JSON. Ebenfalls enthalten sind Tools für die Umstellung Ihrer Anwendung auf Container, einschließlich Unterstützung für Docker.","category":"Web und Cloud","keywords":["HTML","CSS","Javascript/JS","JS","Web","Website","Website","WebAPI","Web-API","MVC","Razor","Web Forms","Web Pages","aspx","cshtml","vbhtml","ASP","Kern",".NET","Typescript","Stylesheet","Azure","Bower","npm","Aspire"]},{"language":"es-es","title":"Desarrollo de ASP.NET y web","description":"Compila aplicaciones web con ASP.NET Core, ASP.NET, HTML/JavaScript y contenedores, e incluye compatibilidad con Docker.","longDescription":"Compila aplicaciones web mediante ASP.NET, ASP.NET Core y tecnologías web basadas en estándares, como HTML, JavaScript, CSS y JSON. Cuenta también con herramientas para incluir la aplicación en contenedores, además de ofrecer compatibilidad con Docker.","category":"Web y nube","keywords":["HTML","CSS","Javascript/JS","JS","Web","WebSite","Sitio web","WebAPI","API web","MVC","Razor","Formularios Web Forms","Web Pages","aspx","cshtml","vbhtml","ASP","Principal",".NET","Typescript","Hoja de estilos","Azure","Bower","Npm","Aspire"]},{"language":"fr-fr","title":"Développement web et ASP.NET","description":"Générez des applications web en utilisant ASP.NET Core, ASP.NET, HTML/JavaScript ainsi que des conteneurs prenant notamment en charge Docker.","longDescription":"Générez des applications web en utilisant ASP.NET Core, ASP.NET ainsi que des technologies web basées sur des standards tels que HTML, JavaScript, CSS et JSON. Comprend également des outils pour conteneuriser votre application en incluant notamment la prise en charge de Docker.","category":"Web et cloud","keywords":["HTML","CSS","Javascript/JS","JS","Web","Siteweb","Site web","WebAPI","API web","MVC","Razor","Web Forms","Pages web","aspx","cshtml","vbhtml","ASP","Principal",".NET","TypeScript","Feuille de style","Azure","Bower","Npm","Aspire"]},{"language":"it-it","title":"Sviluppo ASP.NET e Web","description":"Consente di creare applicazioni Web con ASP.NET Core, ASP.NET, HTML/JavaScript e contenitori, tra cui il supporto Docker.","longDescription":"Consente di creare applicazioni Web con ASP.NET Core, ASP.NET e tecnologie Web basate su standard, tra cui HTML, JavaScript, CSS e JSON. Include anche gli strumenti per inserire l'applicazione in un contenitore, tra cui il supporto Docker.","category":"Web e cloud","keywords":["HTML","CSS","JavaScript/HTML","JS","Web","Sito Web","Sito Web","WebAPI","API Web","MVC","Razor","Web Forms","Pagine Web","aspx","cshtml","vbhtml","ASP","Base",".NET","TypeScript","Foglio di stile","Azure","Bower","Npm","Aspirare"]},{"language":"ja-jp","title":"ASP.NET と Web 開発","description":"ASP.NET Core、ASP.NET、HTML/JavaScript、コンテナー (Docker サポートなど) を使用して、Web アプリケーションをビルドします。","longDescription":"ASP.NET Core、ASP.NET、標準ベースの Web テクノロジ (HTML、JavaScript、CSS、JSON など) を使用して、Web アプリケーションをビルドします。また、Docker のサポートを含め、アプリケーションをコンテナー化するツールも含まれます。","category":"Web & クラウド","keywords":["HTML","CSS","Javascript/JS","JS","Web","Web サイト","Web サイト","WebAPI","Web API","MVC","Razor","Web Forms","Web ページ","aspx","cshtml","vbhtml","ASP","コア",".NET","TypeScript","スタイルシート","Azure","Bower","Npm","Aspire"]},{"language":"ko-kr","title":"ASP.NET 및 웹 개발","description":"Docker 지원이 포함된 ASP.NET Core, ASP.NET, HTML/JavaScript 및 컨테이너를 사용하여 웹 애플리케이션을 빌드합니다.","longDescription":"ASP.NET Core, ASP.NET 및 HTML, JavaScript, CSS, JSON 등의 표준 기반 웹 기술을 사용하여 웹 애플리케이션을 빌드합니다. Docker 지원을 비롯하여, 애플리케이션을 컨테이너화하기 위한 도구도 포함됩니다.","category":"웹 및 클라우드","keywords":["HTML","CSS","Javascript/JS","JS","웹","웹 사이트","웹 사이트","WebAPI","Web API","MVC","Razor","Web Forms","웹 페이지","aspx","cshtml","vbhtml","ASP","코어",".NET","Typescript","스타일시트","Azure","Bower","npm","Aspire"]},{"language":"pl-pl","title":"Opracowywanie zawartości dla platformy ASP.NET i sieci Web","description":"Twórz aplikacje internetowe dla wielu platform przy użyciu technologii ASP.NET Core, ASP.NET, HTML/JavaScript i kontenerów, włącznie z obsługą platformy Docker.","longDescription":"Twórz aplikacje internetowe za pomocą platformy ASP.NET Core, ASP.NET i technologii internetowych opartych na standardach, w tym HTML, JavaScript, CSS i JSON. Zawiera także narzędzia służące do umieszczania aplikacji w kontenerze, włącznie z obsługą platformy Docker.","category":"Sieć Web i chmura","keywords":["HTML","CSS","Javascript/JS","JS","Sieć Web","Witryna sieci Web","Witryna sieci Web","Interfejs API sieci Web","Interfejs API sieci Web","MVC","Razor","Web Forms","Strony sieci Web","aspx","cshtml","vbhtml","ASP","Rdzeń",".NET","Typescript","Arkusz stylów","Azure","Bower","Npm","Aspire"]},{"language":"pt-br","title":"ASP.NET e desenvolvimento Web","description":"Crie aplicativos Web usando ASP.NET Core, ASP.NET, HTML/JavaScript e Contêineres, incluindo suporte a Docker.","longDescription":"Crie aplicativos Web usando ASP.NET Core, ASP.NET e tecnologias Web baseadas em padrões, incluindo HTML, JavaScript, CSS e JSON. Inclui também ferramentas para colocar o seu aplicativo em contêineres, incluindo suporte a Docker.","category":"Web e Nuvem","keywords":["HTML","CSS","Javascript/JS","JS","Web","Site","Site","WebAPI","API Web","MVC","Razor","Web Forms","Páginas da Web","aspx","cshtml","vbhtml","ASP","Core",".NET","Typescript","Folha de estilos","Azure","Bower","Npm","Aspire"]},{"language":"ru-ru","title":"ASP.NET и разработка веб-приложений","description":"Создание веб-приложений с использованием ASP.NET Core, ASP.NET, HTML/JavaScript и контейнеров, включая поддержку Docker.","longDescription":"Создание веб-приложений с использованием ASP.NET Core, ASP.NET и стандартных веб-технологий, включая HTML, JavaScript, CSS и JSON. Также содержит инструменты для создания контейнерных приложений, включая поддержку Docker.","category":"Веб-разработка и облако","keywords":["HTML","CSS","Javascript/JS","JS","Веб","Веб-сайт","Веб-сайт","Веб-API","Веб-API","MVC","Razor","Веб-формы","Веб-страницы","aspx","cshtml","vbhtml","ASP","Core",".NET","Typescript","Таблица стилей","Azure","Bower","Npm","Aspire"]},{"language":"tr-tr","title":"ASP.NET ve web geliştirme","description":"Docker desteği dahil olmak üzere ASP.NET Core, ASP.NET, HTML/JavaScript ve Kapsayıcıları kullanarak web uygulamaları derleyin.","longDescription":"ASP.NET Core ve ASP.NET'in yanı sıra HTML, JavaScript, CSS ve JSON gibi standartlara dayalı web teknolojilerini kullanarak web uygulamaları derleyin. Ayrıca Docker desteği dahil olmak üzere uygulamanızı kapsayıcılı hale getirmek için kullanılan araçlar içerir.","category":"Web ve Bulut","keywords":["HTML","CSS","Javascript/JS","JS","Web","WebSite","Web Sitesi","WebAPI","Web API'si","MVC","Razor","Web Forms","Web Pages","aspx","cshtml","vbhtml","ASP","Çekirdek",".NET","Typescript","Stil sayfası","Azure","Bower","Npm","Aspire"]}]},{"id":"Microsoft.VisualStudio.Workload.Node","version":"17.13.35710.127","type":"Workload","icon":{"mimeType":"image/svg+xml","base64":""},"dependencies":{"Microsoft.VisualStudio.Component.Node.Tools":"[17.0,18.0)","Microsoft.VisualStudio.Component.JavaScript.TypeScript":"[17.0,18.0)","Microsoft.VisualStudio.Component.JavaScript.Diagnostics":"[17.0,18.0)","Microsoft.VisualStudio.PackageGroup.Debugger.Script":"[17.0,18.0)","Microsoft.VisualStudio.Component.WebDeploy":{"version":"[17.0,18.0)","type":"Recommended"},"Component.Microsoft.VisualStudio.LiveShare.2022":{"version":"","type":"Recommended"},"Microsoft.VisualStudio.Component.IntelliCode":{"version":"[17.0,18.0)","type":"Recommended"},"Component.VisualStudio.GitHub.Copilot":{"version":"","type":"Recommended"},"Microsoft.VisualStudio.Component.Common.Azure.Tools":{"version":"[17.0,18.0)","type":"Optional"},"Microsoft.VisualStudio.Component.AppInsights.Tools":{"version":"[17.0,18.0)","type":"Optional"},"Microsoft.VisualStudio.Component.VC.CoreIDE":{"version":"[17.0,18.0)","type":"Optional"},"Microsoft.VisualStudio.Component.VC.Tools.x86.x64":{"version":"[17.0,18.0)","type":"Optional"}},"localizedResources":[{"language":"en-us","title":"Node.js development","description":"Build scalable network applications using Node.js, an asynchronous event-driven JavaScript runtime. ","category":"Web & Cloud"},{"language":"zh-cn","title":"Node.js 开发","description":"使用 Node.js (一个由异步事件驱动的 JavaScript 运行时)生成可缩放的网络应用程序。 ","category":"Web 和云"},{"language":"zh-tw","title":"Node.js 開發","description":"使用非同步的事件驅動 JavaScript 執行階段 Node.js 建置可調整的網路應用程式。","category":"Web 與雲端"},{"language":"cs-cz","title":"Vývoj aplikací Node.js","description":"Můžete sestavovat škálovatelné síťové aplikace využívající Node.js, což je asynchronní javascriptový runtime založený na událostech. ","category":"Web a cloud"},{"language":"de-de","title":"Node.js-Entwicklung","description":"Erstellen Sie skalierbare Netzwerkanwendungen mithilfe von Node.js, einer asynchronen, ereignisgesteuerten JavaScript-Laufzeit. ","category":"Web und Cloud"},{"language":"es-es","title":"Desarrollo de Node.js","description":"Compile aplicaciones de red escalables con Node.js, un entorno de ejecución JavaScript controlado por eventos asincrónicos. ","category":"Web y nube"},{"language":"fr-fr","title":"Développement Node.js","description":"Générez des applications réseau scalables via Node.js, un runtime JavaScript piloté par des événements asynchrones. ","category":"Web et cloud"},{"language":"it-it","title":"Sviluppo Node.js","description":"Consente di compilare applicazioni di rete scalabili con Node.js, un runtime JavaScript basato su eventi asincroni. ","category":"Web e cloud"},{"language":"ja-jp","title":"Node.js 開発","description":"Node.js (非同期イベント ドリブン JavaScript ランタイム) を使用してスケーラブルなネットワーク アプリケーションをビルドします。","category":"Web & クラウド"},{"language":"ko-kr","title":"Node.js 개발","description":"비동기 이벤트 구동 JavaScript 런타임인 Node.js를 사용하여 확장 가능한 네트워크 애플리케이션을 빌드합니다. ","category":"웹 및 클라우드"},{"language":"pl-pl","title":"Programowanie za pomocą oprogramowania Node.js","description":"Twórz skalowalne aplikacje sieciowe przy użyciu środowiska Node.js — asynchronicznego środowiska uruchomieniowego JavaScript opartego na zdarzeniach. ","category":"Sieć Web i chmura"},{"language":"pt-br","title":"Desenvolvimento em node.js","description":"Crie aplicativos de rede escalonáveis usando Node.js, um tempo de execução do JavaScript conduzido por evento assíncrono. ","category":"Web e Nuvem"},{"language":"ru-ru","title":"Разработка Node.js","description":"Создавайте масштабируемые сетевые приложения с помощью Node.js, асинхронной среды выполнения JavaScript с управлением событиями. ","category":"Веб-разработка и облако"},{"language":"tr-tr","title":"Node.js geliştirme","description":"Zaman uyumsuz olay temelli bir JavaScript çalışma zamanı olan Node.js kullanarak ölçeklenebilir ağ uygulamaları oluşturun. ","category":"Web ve Bulut"}]},{"id":"Microsoft.VisualStudio.Workload.NodeBuildTools","version":"17.13.35710.127","type":"Workload","icon":{"mimeType":"image/svg+xml","base64":""},"dependencies":{"Microsoft.VisualStudio.Component.Node.Build":"[17.0,18.0)","Microsoft.VisualStudio.Component.TypeScript.TSServer":"[17.0,18.0)"},"localizedResources":[{"language":"en-us","title":"Node.js build tools","description":"MSBuild tasks and targets for building scalable network applications using Node.js, an asynchronous event-driven JavaScript runtime."},{"language":"zh-cn","title":"Node.js 生成工具","description":"用于使用异步事件驱动型 JavaScript 运行时 Node.js 生成可缩放网络应用程序的 MSBuild 任务和目标。"},{"language":"zh-tw","title":"Node.js 建置工具","description":"用於使用 Node.js 這個非同步事件驅動的 JavaScript 執行階段，建置可調式網路應用程式的 MSBuild 工作與目標。"},{"language":"cs-cz","title":"Nástroje pro sestavování Node.js","description":"Úlohy a cíle nástroje MSBuild pro vytváření škálovatelných síťových aplikací pomocí Node.js, tj. asynchronního modulu runtime JavaScriptu založeného na událostech."},{"language":"de-de","title":"Node.js-Buildtools","description":"MSBuild-Tasks und -Ziele zum Erstellen von skalierbaren Netzwerkanwendungen mit Node.js, einer asynchronen, ereignisgesteuerten JavaScript-Laufzeit."},{"language":"es-es","title":"Herramientas de compilación de Node.js","description":"Tareas de MSBuild y destinos para compilar aplicaciones de red escalables utilizando Node.js, un tiempo de ejecución de JavaScript impulsado por un evento asincrónico."},{"language":"fr-fr","title":"Outils de build Node.js","description":"Tâches et cibles MSBuild pour la génération d'applications réseau scalables via Node.js, un runtime JavaScript piloté par des événements asynchrones."},{"language":"it-it","title":"Strumenti di compilazione Node.js","description":"Attività e destinazioni MSBuild per compilare applicazioni di rete scalabili con Node.js, un runtime JavaScript basato su eventi asincroni."},{"language":"ja-jp","title":"Node.js ビルド ツール","description":"非同期型イベント駆動 JavaScript ランタイムである Node.js を使用してスケーラブルなネットワーク アプリケーションをビルドするための MSBuild タスクおよびターゲットです。"},{"language":"ko-kr","title":"Node.js 빌드 도구","description":"비동기 이벤트 구동 JavaScript 런타임인 Node.js를 사용하여 확장성 있는 네트워크 애플리케이션을 빌드하기 위한 MSBuild 작업 및 대상입니다."},{"language":"pl-pl","title":"Narzędzia do kompilacji Node.js","description":"Zadania i cele programu MSBuild na potrzeby tworzenia skalowalnych aplikacji sieciowych przy użyciu oprogramowania Node.js — asynchronicznego, sterowanego zdarzeniami środowiska uruchomieniowego języka JavaScript."},{"language":"pt-br","title":"Ferramentas de build do Node.js","description":"Tarefas e destinos do MSBuild para criar aplicativos de rede escalonáveis usando o Node.js, um tempo de execução JavaScript controlado por eventos assíncronos."},{"language":"ru-ru","title":"Средства сборки Node.js","description":"Задачи и целевые объекты MSBuild для создания масштабируемых сетевых приложений, использующих Node.js, асинхронную среду выполнения JavaScript, управляемую событиями."},{"language":"tr-tr","title":"Node.js derleme araçları","description":"Zaman uyumsuz olay denetimli bir JavaScript çalışma zamanı olan Node.js kullanılarak ölçeklenebilir ağ uygulamaları oluşturmak için MSBuild görevleri ve hedefleri."}]},{"id":"Microsoft.VisualStudio.Workload.Office","version":"17.13.35710.127","type":"Workload","icon":{"mimeType":"image/svg+xml","base64":""},"dependencies":{"Microsoft.VisualStudio.Component.Sharepoint.Tools":"[17.0,18.0)","Microsoft.Net.ComponentGroup.DevelopmentPrerequisites":"[17.0,18.0)","Microsoft.VisualStudio.PackageGroup.TestTools.Managed":"[17.0,18.0)","Microsoft.VisualStudio.PackageGroup.TestTools.Templates.Managed":"[17.0,18.0)","Microsoft.VisualStudio.Component.AppInsights.Tools":"[17.0,18.0)","Microsoft.VisualStudio.Component.TeamOffice":{"version":"[17.0,18.0)","type":"Recommended"},"Microsoft.VisualStudio.Component.WebDeploy":{"version":"[17.0,18.0)","type":"Recommended"},"Microsoft.VisualStudio.Component.IntelliCode":{"version":"[17.0,18.0)","type":"Recommended"},"Microsoft.Net.ComponentGroup.4.8.DeveloperTools":{"version":"[17.0,18.0)","type":"Recommended","behaviors":"IgnoreApplicabilityFailures"},"Component.VisualStudio.GitHub.Copilot":{"version":"","type":"Recommended"},"Microsoft.VisualStudio.Component.IntelliTrace.FrontEnd_1779377902":{"id":"Microsoft.VisualStudio.Component.IntelliTrace.FrontEnd","v