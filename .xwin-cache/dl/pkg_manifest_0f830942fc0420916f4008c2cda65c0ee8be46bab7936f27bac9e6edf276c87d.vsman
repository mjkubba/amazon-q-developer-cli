tSortOrder":2,"projectType":"Cpp","projectSubType":"WinUI","selects":["Microsoft.VisualStudio.Component.WindowsAppSdkSupport.Cpp"]}],"localizedResources":[{"templateId":"Microsoft.VisualStudio.Breadcrumb.Universal.GetVCSupport","projectTypeDisplayName":"Visual C++","projectSubTypeDisplayName":"Windows Universal","language":"en-us","title":"Install Windows Universal tools for C++ development","description":"Tools for developing Windows Universal C﻿+﻿+ apps are available. Click OK to install."},{"templateId":"Microsoft.VisualStudio.Breadcrumb.Universal.GetWinUICppSupport","projectTypeDisplayName":"WinUI C++","projectSubTypeDisplayName":"WinUI","language":"en-us","title":"Install WinUI tools for C++ development","description":"Tools for developing WinUI C﻿+﻿+ apps are available. Click OK to install."},{"templateId":"Microsoft.VisualStudio.Breadcrumb.Universal.GetVCSupport","projectTypeDisplayName":"Visual C++","projectSubTypeDisplayName":"Windows 通用","language":"zh-cn","title":"安装用于 C++ 开发的 Windows 通用工具","description":"提供了用于开发 Windows 通用 C++ 应用的工具。单击“确定”安装。"},{"templateId":"Microsoft.VisualStudio.Breadcrumb.Universal.GetWinUICppSupport","projectTypeDisplayName":"WinUI C++","projectSubTypeDisplayName":"WinUI","language":"en-us","title":"Install WinUI tools for C++ development","description":"Tools for developing WinUI C﻿+﻿+ apps are available. Click OK to install."},{"templateId":"Microsoft.VisualStudio.Breadcrumb.Universal.GetVCSupport","projectTypeDisplayName":"Visual C++","projectSubTypeDisplayName":"Windows 通用","language":"zh-tw","title":"安裝適用於 C++ 開發的 Windows 通用工具","description":"用於開發 Windows 通用 C ++ 應用程式的工具可供使用。按一下 [確定] 即可安裝。"},{"templateId":"Microsoft.VisualStudio.Breadcrumb.Universal.GetWinUICppSupport","projectTypeDisplayName":"WinUI C++","projectSubTypeDisplayName":"WinUI","language":"en-us","title":"Install WinUI tools for C++ development","description":"Tools for developing WinUI C﻿+﻿+ apps are available. Click OK to install."},{"templateId":"Microsoft.VisualStudio.Breadcrumb.Universal.GetVCSupport","projectTypeDisplayName":"Visual C++","projectSubTypeDisplayName":"Univerzální aplikace pro Windows","language":"cs-cz","title":"Nainstalovat nástroje pro vývoj univerzálních aplikací pro Windows v C++","description":"K dispozici jsou nástroje pro vývoj univerzálních aplikací pro Windows v C++. Kliknutím na OK je nainstalujte."},{"templateId":"Microsoft.VisualStudio.Breadcrumb.Universal.GetWinUICppSupport","projectTypeDisplayName":"WinUI C++","projectSubTypeDisplayName":"WinUI","language":"en-us","title":"Install WinUI tools for C++ development","description":"Tools for developing WinUI C﻿+﻿+ apps are available. Click OK to install."},{"templateId":"Microsoft.VisualStudio.Breadcrumb.Universal.GetVCSupport","projectTypeDisplayName":"Visual C++","projectSubTypeDisplayName":"Windows Universal","language":"de-de","title":"Windows Universal-Tools für die C++-Entwicklung installieren","description":"Tools für die Entwicklung universeller Windows C++-Apps sind verfügbar. Klicken Sie zum Installieren auf OK."},{"templateId":"Microsoft.VisualStudio.Breadcrumb.Universal.GetWinUICppSupport","projectTypeDisplayName":"WinUI C++","projectSubTypeDisplayName":"WinUI","language":"en-us","title":"Install WinUI tools for C++ development","description":"Tools for developing WinUI C﻿+﻿+ apps are available. Click OK to install."},{"templateId":"Microsoft.VisualStudio.Breadcrumb.Universal.GetVCSupport","projectTypeDisplayName":"Visual C++","projectSubTypeDisplayName":"Universal de Windows","language":"es-es","title":"Instalar herramientas universales de Windows para desarrollo de C++","description":"Hay disponibles herramientas para desarrollar aplicaciones universales de Windows con C++. Haga clic en Aceptar para instalarlas."},{"templateId":"Microsoft.VisualStudio.Breadcrumb.Universal.GetWinUICppSupport","projectTypeDisplayName":"WinUI C++","projectSubTypeDisplayName":"WinUI","language":"en-us","title":"Install WinUI tools for C++ development","description":"Tools for developing WinUI C﻿+﻿+ apps are available. Click OK to install."},{"templateId":"Microsoft.VisualStudio.Breadcrumb.Universal.GetVCSupport","projectTypeDisplayName":"Visual C++","projectSubTypeDisplayName":"Windows universel","language":"fr-fr","title":"Installer les outils Windows universels pour développer en C++","description":"Les outils de développement d'applications universelles Windows en C++ sont disponibles. Cliquez sur OK pour effectuer l'installation."},{"templateId":"Microsoft.VisualStudio.Breadcrumb.Universal.GetWinUICppSupport","projectTypeDisplayName":"WinUI C++","projectSubTypeDisplayName":"WinUI","language":"en-us","title":"Install WinUI tools for C++ development","description":"Tools for developing WinUI C﻿+﻿+ apps are available. Click OK to install."},{"templateId":"Microsoft.VisualStudio.Breadcrumb.Universal.GetVCSupport","projectTypeDisplayName":"Visual C++","projectSubTypeDisplayName":"Universale di Windows","language":"it-it","title":"Installa gli strumenti universali di Windows per lo sviluppo C++","description":"Gli strumenti per sviluppare app C++ universali di Windows sono disponibili. Fare clic su OK per installarli."},{"templateId":"Microsoft.VisualStudio.Breadcrumb.Universal.GetWinUICppSupport","projectTypeDisplayName":"WinUI C++","projectSubTypeDisplayName":"WinUI","language":"en-us","title":"Install WinUI tools for C++ development","description":"Tools for developing WinUI C﻿+﻿+ apps are available. Click OK to install."},{"templateId":"Microsoft.VisualStudio.Breadcrumb.Universal.GetVCSupport","projectTypeDisplayName":"Visual C++","projectSubTypeDisplayName":"Windows ユニバーサル","language":"ja-jp","title":"C++ 開発用の Windows ユニバーサル ツールをインストールする","description":"Windows ユニバーサル C ++ アプリを開発するためのツールを利用できます。インストールするには、[OK] をクリックします。"},{"templateId":"Microsoft.VisualStudio.Breadcrumb.Universal.GetWinUICppSupport","projectTypeDisplayName":"WinUI C++","projectSubTypeDisplayName":"WinUI","language":"en-us","title":"Install WinUI tools for C++ development","description":"Tools for developing WinUI C﻿+﻿+ apps are available. Click OK to install."},{"templateId":"Microsoft.VisualStudio.Breadcrumb.Universal.GetVCSupport","projectTypeDisplayName":"Visual C++","projectSubTypeDisplayName":"Windows 유니버설","language":"ko-kr","title":"C++ 개발용 Windows 유니버설 도구 설치","description":"Windows 유니버설 C++ 앱 개발 도구를 사용할 수 있습니다. 설치하려면 [확인]을 클릭합니다."},{"templateId":"Microsoft.VisualStudio.Breadcrumb.Universal.GetWinUICppSupport","projectTypeDisplayName":"WinUI C++","projectSubTypeDisplayName":"WinUI","language":"en-us","title":"Install WinUI tools for C++ development","description":"Tools for developing WinUI C﻿+﻿+ apps are available. Click OK to install."},{"templateId":"Microsoft.VisualStudio.Breadcrumb.Universal.GetVCSupport","projectTypeDisplayName":"Visual C++","projectSubTypeDisplayName":"Projekt uniwersalny systemu Windows","language":"pl-pl","title":"Zainstaluj narzędzia uniwersalne systemu Windows do programowania w języku C++","description":"Dostępne są narzędzia do opracowywania aplikacji uniwersalnych systemu Windows w języku C++. Kliknij przycisk OK, aby je zainstalować."},{"templateId":"Microsoft.VisualStudio.Breadcrumb.Universal.GetWinUICppSupport","projectTypeDisplayName":"WinUI C++","projectSubTypeDisplayName":"WinUI","language":"en-us","title":"Install WinUI tools for C++ development","description":"Tools for developing WinUI C﻿+﻿+ apps are available. Click OK to install."},{"templateId":"Microsoft.VisualStudio.Breadcrumb.Universal.GetVCSupport","projectTypeDisplayName":"Visual C++","projectSubTypeDisplayName":"Universal do Windows","language":"pt-br","title":"Instalar as ferramentas Universal do Windows para desenvolvimento em C++","description":"Há ferramentas disponíveis para desenvolvimento de aplicativos do Universal do Windows C++. Clique em OK para instalar."},{"templateId":"Microsoft.VisualStudio.Breadcrumb.Universal.GetWinUICppSupport","projectTypeDisplayName":"WinUI C++","projectSubTypeDisplayName":"WinUI","language":"en-us","title":"Install WinUI tools for C++ development","description":"Tools for developing WinUI C﻿+﻿+ apps are available. Click OK to install."},{"templateId":"Microsoft.VisualStudio.Breadcrumb.Universal.GetVCSupport","projectTypeDisplayName":"Visual C++","projectSubTypeDisplayName":"Универсальные приложения для Windows","language":"ru-ru","title":"Установить универсальные инструменты Windows для разработчиков C++","description":"Доступны средства для разработки универсальных приложений для Windows на C++. Чтобы установить их, нажмите кнопку 'ОК'."},{"templateId":"Microsoft.VisualStudio.Breadcrumb.Universal.GetWinUICppSupport","projectTypeDisplayName":"WinUI C++","projectSubTypeDisplayName":"WinUI","language":"en-us","title":"Install WinUI tools for C++ development","description":"Tools for developing WinUI C﻿+﻿+ apps are available. Click OK to install."},{"templateId":"Microsoft.VisualStudio.Breadcrumb.Universal.GetVCSupport","projectTypeDisplayName":"Visual C++","projectSubTypeDisplayName":"Windows Evrensel","language":"tr-tr","title":"C++ geliştirme için Windows Evrensel araçlarını yükle","description":"Windows Evrensel C﻿+﻿+ uygulamaları geliştirmeye yönelik araçlar kullanılabilir. Yüklemek için Tamam'a tıklayın."},{"templateId":"Microsoft.VisualStudio.Breadcrumb.Universal.GetWinUICppSupport","projectTypeDisplayName":"WinUI C++","projectSubTypeDisplayName":"WinUI","language":"en-us","title":"Install WinUI tools for C++ development","description":"Tools for developing WinUI C﻿+﻿+ apps are available. Click OK to install."}]},"localizedResources":[{"language":"en-us","title":"WinUI application development","description":"Build applications for the Windows platform using WinUI with C# or optionally C﻿+﻿+.","longDescription":"Build modern Windows apps using WinUI. This advanced UI framework provides the latest graphical capabilities and Fluent design styling with C#, or optionally C﻿+﻿+.","category":"Desktop & Mobile"},{"language":"zh-cn","title":"WinUI 应用程序开发","description":"使用 WinUI 和 C# 为 Windows 平台创建应用程序，或者选择性地使用 C﻿+﻿+ 进行构建。","longDescription":"使用 WinUI 生成新式 Windows 应用。此高级 UI 框架提供使用 C# 或 C++ (可选)的最新图形功能和 Fluent 设计样式。","category":"桌面应用和移动应用"},{"language":"zh-tw","title":"WinUI 應用程式開發","description":"使用 WinUI 搭配 C# 或選用 C++，組建適用於 Windows 平台的應用程式。","longDescription":"使用 WinUI 組建現代化 Windows 應用程式。此進階 UI 框架使用 C# 或選用的 C+﻿+ 提供最新的圖形功能和 Fluent 設計樣式。","category":"傳統型與行動裝置 "},{"language":"cs-cz","title":"Vývoj aplikací WinUI","description":"Vytvářejte aplikace pro platformu Windows pomocí WinUI v jazyce C# nebo volitelně v jazyce C++.","longDescription":"Vytvářejte moderní aplikace pro Windows pomocí WinUI. Tato rozšířená architektura uživatelského rozhraní nabízí nejnovější grafické funkce a styly návrhu Fluent v jazyce C# nebo volitelně C++.","category":"Desktopové a mobilní platformy"},{"language":"de-de","title":"WinUI-Anwendungsentwicklung","description":"Erstellen Sie Anwendungen für die Windows-Plattform mithilfe von WinUI mit C# oder optional C++.","longDescription":"Erstellen Sie moderne Windows-Apps mit WinUI. Dieses erweiterte Benutzeroberflächenframework bietet die neuesten grafischen Funktionen und Fluent Design-Stile mit C# oder optional C++.","category":"Desktop- und Mobilgeräte"},{"language":"es-es","title":"Desarrollo de aplicaciones WinUI","description":"Cree aplicaciones para la plataforma Windows con WinUI con C# o, de forma opcional, C++.","longDescription":"Cree aplicaciones modernas de Windows con WinUI. Este marco de trabajo de la interfaz de usuario avanzado proporciona las funcionalidades gráficas más recientes y el estilo de diseño Fluent con C# u opcionalmente C++.","category":"Móviles y de escritorio"},{"language":"fr-fr","title":"Développement d’applications WinUI","description":"Créez des applications pour la plateforme Windows à l’aide de WinUI avec C#, ou éventuellement C++.","longDescription":"Créez des applications Windows modernes à l’aide de WinUI. Cette infrastructure d’interface utilisateur avancée fournit les dernières fonctionnalités graphiques et le style Fluent Design avec C#, ou éventuellement C++.","category":"Bureau et mobile"},{"language":"it-it","title":"Sviluppo di applicazioni WinUI","description":"Consentono di compilare applicazioni per la piattaforma Windows usando WinUI con C# o facoltativamente C++.","longDescription":"Compilare app di Windows moderne con WinUI. Questo framework avanzato dell'interfaccia utente offre le funzionalità grafiche più recenti e lo stile di Fluent Design con C# o facoltativamente C++.","category":"Desktop e dispositivi mobili"},{"language":"ja-jp","title":"WinUI アプリケーション開発","description":"WinUI と C# または必要に応じて C++ を使用して、Windows プラットフォーム用のアプリケーションをビルドします。","longDescription":"WinUI を使用して最新の Windows アプリをビルドします。この高度な UI フレームワークは、最新のグラフィカル機能と Fluent Design スタイルを C# またはオプションで C++ で提供します。","category":"デスクトップとモバイル"},{"language":"ko-kr","title":"WinUI 애플리케이션 개발","description":"C# 또는 선택 사항으로 C﻿+﻿+와 함께 WinUI를 사용하여 Windows 플랫폼용 애플리케이션을 빌드합니다.","longDescription":"WinUI를 사용하여 최신 Windows 앱을 빌드합니다. 이 고급 UI 프레임워크는 C#을 사용하는 최신 그래픽 기능 및 Fluent 디자인 스타일 또는 C++(선택 사항)를 제공합니다.","category":"데스크톱 및 모바일"},{"language":"pl-pl","title":"Tworzenie aplikacji WinUI","description":"Twórz aplikacje dla platformy systemu Windows przy użyciu biblioteki WinUI z językiem C# lub opcjonalnie C++.","longDescription":"Twórz nowoczesne aplikacje systemu Windows przy użyciu interfejsu WinUI. To zaawansowane środowisko interfejsu użytkownika udostępnia najnowsze możliwości graficzne i style projektowania w języku Fluent przy użyciu języka C# lub opcjonalnie C++.","category":"Komputery i urządzenia przenośne"},{"language":"pt-br","title":"Desenvolvimento de aplicativo WinUI","description":"Crie aplicativos para a plataforma Windows usando WinUI com C# ou, opcionalmente, C++.","longDescription":"Compile aplicativos modernos do Windows usando o WinUI. Essa estrutura de interface do usuário avançada fornece os recursos gráficos mais recentes e o estilo do Fluent Design com C# ou, opcionalmente, C++.","category":"Área de trabalho e Dispositivos móveis"},{"language":"ru-ru","title":"Разработка приложений WinUI","description":"Создавайте приложения для платформы Windows, используя WinUI с C# или, при необходимости, C﻿+﻿+.","longDescription":"Выполняйте сборку современных приложений для Windows с помощью WinUI. Эта расширенная платформа пользовательского интерфейса предоставляет новейшие графические возможности и стили оформления Fluent на C# или C++ (при необходимости).","category":"Классические и мобильные приложения"},{"language":"tr-tr","title":"WinUI uygulama geliştirme","description":"C# veya isteğe bağlı olarak C﻿+﻿+ ile WinUI kullanarak Windows platformu için uygulamalar oluşturun.","longDescription":"WinUI'yi kullanarak modern Windows uygulamaları oluşturun. Bu gelişmiş kullanıcı arabirimi altyapısı, C# veya isteğe bağlı olarak C﻿+﻿+ ile en yeni grafik yeteneklerini ve Akıcı tasarım stilini sağlar.","category":"Masaüstü ve Mobil"}]},{"id":"Microsoft.VisualStudio.Workload.Universal","version":"17.13.35710.127","type":"Workload","productArch":"x64","icon":{"mimeType":"image/svg+xml","base64":""},"dependencies":{"Microsoft.VisualStudio.ComponentGroup.WindowsAppDevelopment.Prerequisites":"[17.0,18.0)","Microsoft.VisualStudio.ComponentGroup.UWP.NetCoreAndStandard":"[17.0,18.0)","Microsoft.VisualStudio.Component.NuGet":"[17.0,18.0)","Microsoft.VisualStudio.Component.IntelliCode":{"version":"[17.0,18.0)","type":"Recommended"},"Microsoft.VisualStudio.Component.IntelliTrace.FrontEnd_1779377902":{"id":"Microsoft.VisualStudio.Component.IntelliTrace.FrontEnd","version":"[17.0,18.0)","type":"Recommended","when":["Microsoft.VisualStudio.Product.EnterpriseX86","Microsoft.VisualStudio.Product.Enterprise"]},"Component.VisualStudio.GitHub.Copilot":{"version":"","type":"Recommended"},"Microsoft.VisualStudio.ComponentGroup.WindowsAppDevelopment.VC":{"version":"[17.0,18.0)","type":"Optional"},"Microsoft.Visua