ft.com/download/pr/a30b3737-77d0-4afc-9cee-34c41fa64a26/20e663ebab555493081c06f72c9c3553caaf5f4ba6fea103a27323cca0a8cd32/netfx_bootstrapper.msi","signer":{"$ref":"3"}},{"fileName":"cab1.cab","sha256":"ffc0eb3b86e52bc6a83d859c1ba6d77c0eb9d5bca4abe51f1b4c06416d0a6cfa","size":140442,"url":"https://download.visualstudio.microsoft.com/download/pr/a30b3737-77d0-4afc-9cee-34c41fa64a26/ffc0eb3b86e52bc6a83d859c1ba6d77c0eb9d5bca4abe51f1b4c06416d0a6cfa/cab1.cab","signer":{"$ref":"3"}}],"msiProperties":{"MSIFASTINSTALL":"7"},"productCode":"{BDF8C840-5B9A-4D9B-9BCA-CE4163973563}","upgradeCode":"{D4BB1CBC-C0F2-4F99-A2AF-FEE36274150C}","productVersion":"4.8.9256","productLanguage":1033,"providerKey":"Microsoft.VS.NetFx_Bootstrapper.462","installSizes":{"systemDrive":10361096}},{"id":"Microsoft.Net.Component.3.5.DeveloperTools","version":"17.13.35710.127","type":"Component","automaticallyAddedByExtensionPack":false,"dependencies":{"Microsoft.Net.3.5.SDK":"3.11.50727","Microsoft.NET.3.5.TargetingPack.Resources":"[17.0,18.0)"},"localizedResources":[{"language":"en-us","title":".NET Framework 3.5 development tools","description":"Tools, libraries, header files, documentation, and samples to build and deploy .NET Framework 3.5 applications.","category":".NET"},{"language":"zh-cn","title":".NET Framework 3.5 开发工具","description":"用于生成和部署 .NET Framework 3.5 应用程序的工具、库、头文件、文档和示例。","category":".NET"},{"language":"zh-tw","title":".NET Framework 3.5 開發工具","description":"工具、程式庫、標頭檔、文件與範例，用於建置及部署 .NET Framework 3.5 應用程式。","category":".NET"},{"language":"cs-cz","title":"Vývojové nástroje pro .NET Framework 3.5","description":"Nástroje, knihovny, hlavičkové soubory, dokumentace a ukázky pro sestavování a nasazování aplikací využívajících rozhraní .NET Framework 3.5","category":".NET"},{"language":"de-de","title":".NET Framework 3.5-Entwicklungstools","description":"Tools, Bibliotheken, Headerdateien, Dokumentation und Beispiele zum Erstellen und Bereitstellen von .NET Framework 3.5-Anwendungen.","category":".NET"},{"language":"es-es","title":"Herramientas de desarrollo para .NET Framework 3.5","description":"Herramientas, bibliotecas, archivos de encabezado, documentación y ejemplos para compilar e implementar aplicaciones de .NET Framework 3.5.","category":".NET"},{"language":"fr-fr","title":"Outils de développement .NET Framework 3.5","description":"Outils, bibliothèques, fichiers d'en-tête, documentation et exemples pour générer et déployer des applications .NET Framework 3.5.","category":".NET"},{"language":"it-it","title":"Strumenti di sviluppo per .NET Framework 3.5","description":"Strumenti, librerie, file di intestazione, documentazione ed esempi per compilare e distribuire applicazioni .NET Framework 3.5.","category":".NET"},{"language":"ja-jp","title":".NET Framework 3.5 開発ツール","description":".NET Framework 3.5 アプリケーションをビルドして展開するためのツール、ライブラリ、ヘッダー ファイル、ドキュメント、サンプル。","category":".NET"},{"language":"ko-kr","title":".NET Framework 3.5 개발 도구","description":".NET Framework 3.5 애플리케이션을 빌드 및 배포하기 위한 도구, 라이브러리, 헤더 파일, 설명서 및 샘플입니다.","category":".NET"},{"language":"pl-pl","title":"Narzędzia programistyczne programu .NET Framework 3.5","description":"Narzędzia, biblioteki, pliki nagłówka, dokumentacja i przykłady do kompilowania oraz wdrażania aplikacji platformy .NET Framework 3.5.","category":".NET"},{"language":"pt-br","title":"Ferramentas de desenvolvimento do .NET Framework 3.5","description":"Ferramentas, bibliotecas, arquivos de cabeçalho, documentação e amostras para compilar e implantar aplicativos .NET Framework 3.5.","category":".NET"},{"language":"ru-ru","title":"Средства разработки для .NET Framework 3.5","description":"Инструменты, библиотеки, файлы заголовков, документация и примеры, позволяющие разрабатывать и развертывать приложения для платформы .NET Framework 3.5.","category":".NET"},{"language":"tr-tr","title":".NET Framework 3.5 geliştirme araçları","description":".NET Framework 3.5 uygulamaları derlemeye ve dağıtmaya yönelik araçlar, kitaplıklar, üst bilgi dosyaları, belgeler ve örnekler.","category":".NET"}]},{"id":"Microsoft.Net.Component.4.5.2.TargetingPack","version":"17.13.35710.127","type":"Component","automaticallyAddedByExtensionPack":false,"dependencies":{"Microsoft.Net.4.5.2.TargetingPack":"4.5.51651"},"localizedResources":[{"language":"en-us","title":".NET Framework 4.5.2 targeting pack","description":"Reference assemblies to build applications that target the .NET Framework 4.5.2.","category":".NET"},{"language":"zh-cn","title":".NET Framework 4.5.2 目标包","description":"用于生成面向 .NET Framework 4.5.2 的应用程序的引用程序集。","category":".NET"},{"language":"zh-tw","title":".NET Framework 4.5.2 目標套件","description":"參考組件，用於建置以 .NET Framework 4.5.2 為目標的應用程式。","category":".NET"},{"language":"cs-cz","title":".NET Framework 4.5.2 Targeting Pack","description":"Referenční sestavení pro vytváření aplikací určených pro rozhraní .NET Framework 4.5.2","category":".NET"},{"language":"de-de","title":"Paket zur Festlegung von Zielversionen von .NET Framework 4.5.2","description":"Verweisassemblys zum Erstellen von Anwendungen für .NET Framework 4.5.2.","category":".NET"},{"language":"es-es","title":"Paquete de compatibilidad de .NET Framework 4.5.2","description":"Ensamblados de referencia para compilar aplicaciones destinadas a .NET Framework 4.5.2.","category":".NET"},{"language":"fr-fr","title":"Pack de ciblage .NET Framework 4.5.2","description":"Assemblys de référence pour générer des applications qui ciblent .NET Framework 4.5.2.","category":".NET"},{"language":"it-it","title":".NET Framework 4.5.2 Targeting Pack","description":"Assembly di riferimento per compilare applicazioni destinate a .NET Framework 4.5.2.","category":".NET"},{"language":"ja-jp","title":".NET Framework 4.5.2 Targeting Pack","description":".NET Framework 4.5.2 をターゲットとするアプリケーションをビルドする参照アセンブリ。","category":".NET"},{"language":"ko-kr","title":".NET Framework 4.5.2 타기팅 팩","description":".NET Framework 4.5.2를 대상으로 하는 애플리케이션을 빌드하기 위한 참조 어셈블리입니다.","category":".NET"},{"language":"pl-pl","title":".NET Framework 4.5.2 Targeting Pack","description":"Zestawy referencyjne do kompilowania aplikacji przeznaczonych dla platformy .NET Framework 4.5.2","category":".NET"},{"language":"pt-br","title":"Pacote de direcionamento do .NET Framework 4.5.2","description":"Assemblies de referência para compilar aplicativos direcionados ao .NET Framework 4.5.2.","category":".NET"},{"language":"ru-ru","title":".NET Framework 4.5.2 Targeting Pack","description":"Ссылочные сборки для разработки приложений, предназначенных для платформы .NET Framework 4.5.2.","category":".NET"},{"language":"tr-tr","title":".NET Framework 4.5.2 Targeting Pack","description":".NET Framework 4.5.2'yi hedefleyen uygulamalar derlemeye yönelik başvuru bütünleştirilmiş kodları.","category":".NET"}]},{"id":"Microsoft.Net.Component.4.6.1.SDK","version":"17.13.35710.127","type":"Component","automaticallyAddedByExtensionPack":false,"dependencies":{"Microsoft.Net.4.6.1.SDK":"4.6.1055","Microsoft.Net.4.6.1.SDK.Resources":"4.6.1055"},"localizedResources":[{"language":"en-us","title":".NET Framework 4.6.1 SDK","description":"When targeting all versions of the .NET Framework, we recommend customers use the .NET Framework 4.8 SDK to receive the highest level of security and reliability.","category":".NET"},{"language":"zh-cn","title":".NET Framework 4.6.1 SDK","description":"在面向所有版本的 .NET Framework 时，建议客户使用 .NET Framework 4.8 SDK 来获得最高级别的安全性和可靠性。","category":".NET"},{"language":"zh-tw","title":".NET Framework 4.6.1 SDK","description":"當目標為所有版本的 .NET Framework 時，我們建議客戶使用 .NET Framework 4.8 SDK 來獲得最高級別的安全性與可靠性。","category":".NET"},{"language":"cs-cz","title":".NET Framework 4.6.1 SDK","description":"Při cílení na všechny verze .NET Framework doporučujeme, aby zákazníci použili sadu .NET Framework 4.8 SDK a získali tak nejvyšší úroveň zabezpečení a spolehlivosti.","category":".NET"},{"language":"de-de","title":".NET Framework 4.6.1 SDK","description":"Wenn alle Versionen von .NET Framework als Ziel verwendet werden sollen, empfehlen wir den Kunden die Verwendung von .NET Framework 4.8 SDK, um den höchsten Grad an Sicherheit und Zuverlässigkeit zu erhalten.","category":".NET"},{"language":"es-es","title":"SDK de .NET Framework 4.6.1","description":"Cuando el destino son todas las versiones de .NET Framework, se recomienda que los clientes usen el SDK de .NET Framework 4.8 para obtener el nivel más alto de seguridad y confiabilidad.","category":".NET"},{"language":"fr-fr","title":"SDK .NET Framework 4.6.1","description":"Nous recommandons aux clients qui ciblent toutes les versions du .NET Framework d'utiliser le kit SDK .NET Framework 4.8 pour bénéficier du plus haut niveau de sécurité et de fiabilité.","category":".NET"},{"language":"it-it","title":".NET Framework 4.6.1 SDK","description":"Quando la destinazione impostata corrisponde a tutte le versioni di .NET Framework, è consigliabile che i clienti usino .NET Framework 4.8 SDK per usufruire del livello più elevato in termini di sicurezza e affidabilità.","category":".NET"},{"language":"ja-jp","title":".NET Framework 4.6.1.SDK","description":".NET Framework のすべてのバージョンをターゲットとする場合、最高レベルのセキュリティと信頼性を確保できるよう、.NET Framework 4.8 SDK を使用することをお客様にお勧めします。","category":".NET"},{"language":"ko-kr","title":".NET Framework 4.6.1 SDK","description":".NET Framework의 모든 버전을 대상으로 하는 경우 고객은 최고 수준의 보안 및 안정성을 적용받기 위해 .NET Framework 4.8 SDK를 사용하는 것이 좋습니다.","category":".NET"},{"language":"pl-pl","title":".NET Framework 4.6.1 SDK","description":"Jeśli wszystkie wersje platformy .NET Framework są określone jako docelowe, zalecamy klientom użycie zestawu .NET Framework 4.8 SDK w celu uzyskania najwyższego poziomu zabezpieczeń i niezawodności.","category":".NET"},{"language":"pt-br","title":"SDK do .NET Framework 4.6.1","description":"Ao escolher todas as versões do .NET Framework como o destino, recomendamos que os clientes usem o SDK do .NET Framework 4.8 para receber o mais alto nível de segurança e confiabilidade.","category":".NET"},{"language":"ru-ru","title":"Пакет SDK для .NET Framework 4.6.1","description":"При разработке для всех версий .NET Framework клиентам рекомендуется использовать пакет SDK для .NET Framework 4.8, чтобы получить максимальный уровень надежности и безопасности.","category":".NET"},{"language":"tr-tr","title":".NET Framework 4.6.1 SDK","description":"Tüm .NET Framework sürümleri hedeflenirken, müşterilerin en yüksek güvenlik düzeyini ve güvenilirliğini elde etmek için .NET Framework 4.8 SDK'yı kullanmaları önerilir.","category":".NET"}]},{"id":"Microsoft.Net.Component.4.6.1.TargetingPack","version":"17.13.35710.127","type":"Component","automaticallyAddedByExtensionPack":false,"dependencies":{"Microsoft.Net.4.6.1.TargetingPack":"4.6.1055"},"localizedResources":[{"language":"en-us","title":".NET Framework 4.6.1 targeting pack","description":"Reference assemblies to build applications that target the .NET Framework 4.6.1.","category":".NET"},{"language":"zh-cn","title":".NET Framework 4.6.1 目标包","description":"用于生成面向 .NET Framework 4.6.1 的应用程序的引用程序集。","category":".NET"},{"language":"zh-tw","title":".NET Framework 4.6.1 目標套件","description":"參考組件，用於建置以 .NET Framework 4.6.1 為目標的應用程式。","category":".NET"},{"language":"cs-cz","title":".NET Framework 4.6.1 Targeting Pack","description":"Referenční sestavení pro vytváření aplikací určených pro rozhraní .NET Framework 4.6.1","category":".NET"},{"language":"de-de","title":"Paket zur Festlegung von Zielversionen von .NET Framework 4.6.1","description":"Verweisassemblys zum Erstellen von Anwendungen für .NET Framework 4.6.1.","category":".NET"},{"language":"es-es","title":"Paquete de compatibilidad de .NET Framework 4.6.1","description":"Ensamblados de referencia para compilar aplicaciones destinadas a .NET Framework 4.6.1.","category":".NET"},{"language":"fr-fr","title":"Pack de ciblage .NET Framework 4.6.1","description":"Assemblys de référence pour générer des applications qui ciblent .NET Framework