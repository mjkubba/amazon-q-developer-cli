ix","signer":{"$ref":"1"}}],"installSizes":{}},{"id":"Microsoft.VisualStudio.Component.AppInsights.Tools","version":"17.13.35710.127","type":"Component","automaticallyAddedByExtensionPack":false,"dependencies":{"Microsoft.VisualStudio.ApplicationInsights":"[16.0,18.0)","Microsoft.VisualStudio.ApplicationInsights.Interfaces":"[16.0,18.0)","Microsoft.VisualStudio.PackageGroup.NuGet":"[16.0,18.0)","Microsoft.VisualStudio.NuGet.Licenses":"[17.0,18.0)","Microsoft.VisualStudio.NuGet.PowershellBindingRedirect":{"version":"[17.0,18.0)","behaviors":"IgnoreApplicabilityFailures"},"Microsoft.VisualStudio.ConnectedServices.Core":"[16.0,18.0)","Microsoft.VisualStudio.ProTools":"[17.0,18.0)","Microsoft.VisualStudio.MinShell":"[17.0,18.0)"},"localizedResources":[{"language":"en-us","title":"Developer Analytics tools","description":"Telemetry search, CodeLens integration, and other tools for Application Insights.","category":"Code tools"},{"language":"zh-cn","title":"Developer Analytics Tools","description":"遥测搜索、CodeLens 集成和适用于 Application Insights 的其他工具。","category":"代码工具"},{"language":"zh-tw","title":"Developer Analytics Tools","description":"適用於 Application Insights 的遙測搜尋、CodeLens 整合及其他工具。","category":"程式碼工具"},{"language":"cs-cz","title":"Developer Analytics Tools","description":"Vyhledávání telemetrie, integrace CodeLensu a další nástroje pro Application Insights","category":"Nástroje pro kód"},{"language":"de-de","title":"Developer Analytics Tools","description":"Telemetriesuche, CodeLens-Integration und weitere Tools für Application Insights.","category":"Codetools"},{"language":"es-es","title":"Developer Analytics Tools","description":"Búsqueda de telemetría, integración de CodeLens y otras herramientas para Application Insights.","category":"Herramientas de código"},{"language":"fr-fr","title":"Developer Analytics Tools","description":"Recherche de télémétrie, intégration de CodeLens et autres outils pour Application Insights.","category":"Outils de code"},{"language":"it-it","title":"Developer Analytics Tools","description":"Ricerca con telemetria, integrazione di CodeLens e altri strumenti per Application Insights.","category":"Strumenti per il codice"},{"language":"ja-jp","title":"Developer Analytics Tools","description":"テレメトリ検索、CodeLens 統合、Application Insights のその他のツール。","category":"コード ツール"},{"language":"ko-kr","title":"Developer Analytics Tools","description":"Application Insights에 대한 원격 분석 검색, CodeLens 통합 및 기타 도구","category":"코드 도구"},{"language":"pl-pl","title":"Developer Analytics Tools","description":"Wyszukiwanie telemetryczne, integracja z funkcją CodeLens i inne narzędzia dla usługi Application Insights.","category":"Narzędzia do kodowania"},{"language":"pt-br","title":"Developer Analytics Tools","description":"Pesquisa de telemetria, integração do CodeLens e outras ferramentas do Application Insights.","category":"Ferramentas de código"},{"language":"ru-ru","title":"Developer Analytics Tools","description":"Поиск телеметрии, интеграция с CodeLens и другие средства для Application Insights.","category":"Средства для работы с кодом"},{"language":"tr-tr","title":"Developer Analytics Tools","description":"Telemetri araması, CodeLens tümleştirmesi ve Application Insights için diğer araçlar.","category":"Kod araçları"}]},{"id":"Microsoft.VisualStudio.Component.AspNet","version":"17.13.35710.127","type":"Component","automaticallyAddedByExtensionPack":false,"dependencies":{"Microsoft.VisualStudio.Component.AspNet45":{"version":"[17.0,18.0)","type":"Recommended"},"Microsoft.VisualStudio.PackageGroup.WebStackRuntime":"[17.0,18.0)","Microsoft.VisualStudio.PackageGroup.WebToolsExtensions.Templates":"[17.0,18.0)","Microsoft.VisualStudio.Templates.CS.EdgeDriverTest":"[16.0,18.0)"},"localizedResources":[{"language":"en-us","title":".NET Framework project and item templates","description":"Enables .NET Framework project templates, item templates & related features for .NET Framework development.","category":".NET"},{"language":"zh-cn","title":".NET Framework 项目和项模板","description":"启用 .NET Framework 项目模板、项模板和 .NET Framework 开发的相关功能。","category":".NET"},{"language":"zh-tw","title":".NET Framework 專案與項目範本","description":"為 .NET Framework 開發啟用 .NET Framework 專案範本、項目範本與相關功能。","category":".NET"},{"language":"cs-cz","title":"Šablony projektů a položek .NET Framework","description":"Umožňuje povolit šablony projektů .NET Framework, šablony položek a související funkce pro vývoj v .NET Frameworku.","category":".NET"},{"language":"de-de","title":".NET Framework Projekt- und Elementvorlagen","description":"Aktiviert .NET Framework Projektvorlagen, Elementvorlagen und zugehörige Features für die .NET Framework Entwicklung.","category":".NET"},{"language":"es-es","title":"Plantillas de proyecto y de elemento de .NET Framework","description":"Habilita las plantillas de proyecto y de elemento de .NET Framework y características relacionadas para el desarrollo con .NET Framework.","category":".NET"},{"language":"fr-fr","title":"Modèles d'éléments et de projets .NET Framework","description":"Active les modèles de projet et les modèles d’élément .NET Framework, ainsi que les fonctionnalités associées pour le développement .NET Framework.","category":".NET"},{"language":"it-it","title":"Modelli di progetto ed elementi .NET Framework","description":"Abilita modelli di progetto ed elementi .NET Framework, modelli di elementi e funzionalità correlate per lo sviluppo di .NET Framework.","category":".NET"},{"language":"ja-jp","title":".NET Framework プロジェクトと項目テンプレート","description":".NET Framework 開発のために、.NET Framework プロジェクト テンプレート、項目テンプレート、および関連する機能.を有効にします。","category":".NET"},{"language":"ko-kr","title":".NET Framework 프로젝트 및 항목 템플릿","description":".NET Framework 프로젝트 템플릿, 항목 템플릿 및 .NET Framework 개발용 항목 템플릿 관련 기능을 사용 합니다.","category":".NET"},{"language":"pl-pl","title":"Szablony projektów i elementów .NET Framework","description":"Umożliwia tworzenie szablonów projektów .NET Framework, szablonów elementów i powiązanych funkcji dla rozwoju .NET Framework.","category":".NET"},{"language":"pt-br","title":"Modelos de projeto e item do .NET Framework","description":"Habilita os modelos de projeto do .NET Framework, modelos de item e recursos relacionados para o desenvolvimento .NET Framework.","category":".NET"},{"language":"ru-ru","title":"Шаблоны проектов и элементов .NET Framework","description":"Позволяет использовать шаблоны проектов и элементов вместе с сопутствующими функциями для разработки на платформе .NET Framework.","category":".NET"},{"language":"tr-tr","title":".NET Framework proje ve öğe şablonları","description":".NET Framework geliştirme için .NET Framework proje şablonlarını, öğe şablonlarını ve ilgili özelliklerini etkinleştirir.","category":".NET"}]},{"id":"Microsoft.VisualStudio.Component.AspNet45","version":"17.13.35710.127","type":"Component","automaticallyAddedByExtensionPack":false,"dependencies":{"Microsoft.VisualStudio.AspNet45.Feature":{"version":"[17.0,18.0)","behaviors":"IgnoreApplicabilityFailures"}},"localizedResources":[{"language":"en-us","title":"Advanced ASP.NET features","description":"Enables advanced ASP.NET features through Windows such as performance counters, event tracing and out-of-process session state support.","category":".NET"},{"language":"zh-cn","title":"高级 ASP.NET 功能","description":"通过 Windows 启用高级 ASP.NET 功能，例如性能计数器、事件跟踪和进程外会话状态支持。","category":".NET"},{"language":"zh-tw","title":"進階的 ASP.NET 功能","description":"透過 Windows 啟用進階的 ASP.NET 功能，例如效能計數器、 事件追蹤，以及以自有程序執行之工作階段狀態支援。","category":".NET"},{"language":"cs-cz","title":"Rozšířené funkce ASP.NET","description":"Povolí rozšířené funkce ASP.NET prostřednictvím Windows, například čítače výkonu, trasování událostí a podporustavu relace mimo proces.","category":".NET"},{"language":"de-de","title":"Erweiterte ASP.NET-Features","description":"Aktiviert erweiterte ASP.NET-Features über Windows, beispielsweise Leistungsindikatoren, Ereignisablaufverfolgung und Unterstützung für den prozessexternen Sitzungszustand.","category":".NET"},{"language":"es-es","title":"Características avanzadas de ASP.NET","description":"Habilita las características avanzadas de ASP.NET a través de Windows, como contadores de rendimiento, seguimiento de eventos y estado de sesión fuera de proceso.","category":".NET"},{"language":"fr-fr","title":"Fonctionnalités ASP.NET avancées","description":"Active les fonctionnalités ASP.NET avancées par le biais de Windows, telles que les compteurs de performance, le suivi d'événements et la prise en charge de l'état de session hors processus.","category":".NET"},{"language":"it-it","title":"Funzionalità avanzate di ASP.NET","description":"Abilita funzionalità avanzate di ASP.NET tramite Windows, come contatori delle prestazioni, traccia eventi e supporto per gli stati di sessione out-of-process.","category":".NET"},{"language":"ja-jp","title":"高度な ASP.NET 機能","description":"パフォーマンス カウンター、イベント トレース、アウト プロセス セッション状態のサポートなど、Windows を利用した高度な ASP.NET 機能を有効にします。","category":".NET"},{"language":"ko-kr","title":"고급 ASP.NET 기능","description":"성능 카운터, 이벤트 추적 및 Out of Process 세션 상태 지원과 같은 Windows를 통한 고급 ASP.NET 기능을 사용합니다.","category":".NET"},{"language":"pl-pl","title":"Zaawansowane funkcje platformy ASP.NET","description":"Udostępnia za pośrednictwem systemu Windows zaawansowane funkcje platformy ASP.NET, takie jak liczniki wydajności, śledzenie zdarzeń i obsługę pozaprocesowych stanów sesji.","category":".NET"},{"language":"pt-br","title":"Recursos avançados do ASP.NET","description":"Habilita recursos do ASP.NET avançados por meio do Windows, como contadores de desempenho, rastreamento de eventos e suporte de estado de sessão fora de processo.","category":".NET"},{"language":"ru-ru","title":"Расширенные возможности ASP.NET","description":"Предоставляет дополнительные функции ASP.NET через Windows как счетчики производительности для отслеживания событий и поддержки состояния сеанса вне процесса.","category":".NET"},{"language":"tr-tr","title":"Gelişmiş ASP.NET özellikleri","description":"Performans sayaçları, olay izleme ve işlem dışı oturum durumu desteği gibi gelişmiş ASP.NET özelliklerini Windows üzerinden etkinleştirir.","category":".NET"}]},{"id":"Microsoft.VisualStudio.Component.Azure.AuthoringTools","version":"17.13.35710.127","type":"Component","automaticallyAddedByExtensionPack":false,"dependencies":{"Microsoft.Azure.AuthoringTools.Msi":"2.9.8999"},"localizedResources":[{"language":"en-us","title":"Azure Authoring Tools","description":"Tools for editing, debugging, and deploying scalable web applications and services on Microsoft Azure.","category":"Cloud, database, and server","keywords":["Azure"]},{"language":"zh-cn","title":"Azure 创作工具","description":"用于在 Microsoft Azure 中编辑、调试和部署可缩放 Web 应用程序的工具。","category":"云、数据库和服务器","keywords":["Azure"]},{"language":"zh-tw","title":"Azure 製作工具","description":"工具，用於在 Microsoft Azure 上編輯、偵錯及部署可調整的 Web 應用程式與服務。","category":"雲端、資料庫和伺服器","keywords":["Azure"]},{"language":"cs-cz","title":"Azure Authoring Tools","description":"Nástroje na úpravu, ladění a nasazování škálovatelných webových aplikací a služeb do Microsoft Azure","category":"Cloud, databáze a server","keywords":["Azure"]},{"language":"de-de","title":"Azure-Dokumenterstellungstools","description":"Tools zum Bearbeiten, Debuggen und Bereitstellen skalierbarer Webanwendungen und -dienste in Microsoft Azure.","category":"Cloud, Datenbank und Server","keywords":["Azure"]},{"language":"es-es","title":"Herramientas de creación de Azure","description":"Herramientas para editar, depurar e implementar servicios y aplicaciones web escalables en Microsoft Azure.","category":"Nube, base de datos y servidor","keywords":["Azure"]},{"language":"fr-fr","title":"Outils de création Azure","description":"Outils permettant de modifier, déboguer et déployer des applications et services web scalables sur Microsoft Azure.","category":"Cloud, base de données et serveur","keywords":["Azure"]},{"language":"it-it","title":"Strumenti di creazione di Azure","description":"Strumenti per la modifica, il debug e la distribuzione di servizi e applicazioni Web scalabili in Microsoft Azure.","category":"Cloud, database e server","keywords":["Azure"]},{"language":"ja-jp","title":"Azure Authoring Tools","description":"Microsoft Azure 上でスケーラブルな Web アプリケーションとサービスを編集、デバッグ、展開するためのツール。","category":"クラウド、データベース、およびサーバー","keywords":["Azure"]},{"language":"ko-kr","title":"Azure 작성 도구","description":"Microsoft Azure에서 확장 가능한 웹 애플리케이션 및 서비스를 편집하고 디버그하고 배포하는 도구입니다.","category":"클라우드, 데이터베이스 및 서버","keywords":["Azure"]},{"language":"pl-pl","title":"Azure Authoring Tools","description":"Narzędzia do edytowania, debugowania i wdrażania skalowalnych aplikacji internetowych i usług na platformie Microsoft Azure.","category":"Chmura, baza danych i serwer","keywords":["Azure"]},{"language":"pt-br","title":"Ferramentas de Criação do Azure","description":"Ferramentas para edição, depuração e implantação de aplicativos Web e serviços escalonáveis no Microsoft Azure.","category":"Nuvem, banco de dados e servidor","keywords":["Azure"]},{"language":"ru-ru","title":"Средства разработчика для Azure","description":"Средства для редактирования, отладки и развертывания масштабируемых веб-приложений и служб в Microsoft Azure.","category":"Облако, база данных и сервер","keywords":["Azure"]},{"language":"tr-tr","title":"Azure Yazma Araçları","description":"Microsoft Azure'da ölçeklenebilir Web uygulamaları ve hizmetleri oluşturma, hata ayıklama ve dağıtma olanağı sunan araçlar.","category":"Bulut, veritabanı ve sunucu","keywords":["Azure"]}]},{"id":"Microsoft.VisualStudio.Component.Azure.ClientLibs","version":"17.13.35710.127","type":"Component","automaticallyAddedByExtensionPack":false,"dependencies":{"Microsoft.Azure.ClientLibs.Msi":""},"localizedResources":[{"language":"en-us","title":"Azure libraries for .NET","description":"Client libraries for the Azure SDK for .NET provides locally available packages for various components.","