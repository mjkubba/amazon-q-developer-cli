,"dependencies":{"Microsoft.Net.Component.4.8.SDK":"[17.0,18.0)","Microsoft.Net.Component.4.7.2.TargetingPack":"[17.0,18.0)","Microsoft.Net.Component.4.6.1.TargetingPack":"[17.0,18.0)","Microsoft.VisualStudio.VC.Templates.CLR_-104079356":{"id":"Microsoft.VisualStudio.VC.Templates.CLR","version":"[17.0,18.0)","when":["Microsoft.VisualStudio.Product.Enterprise","Microsoft.VisualStudio.Product.Professional","Microsoft.VisualStudio.Product.Community"]},"Microsoft.VC.14.32.17.2.CLI.ARM":"[14.0,18.0)","Microsoft.VC.14.32.17.2.CLI.ARM64":"[14.0,18.0)","Microsoft.VC.14.32.17.2.CLI.Source":"[14.0,18.0)","Microsoft.VC.14.32.17.2.CLI.X64":"[14.0,18.0)","Microsoft.VC.14.32.17.2.CLI.X86":"[14.0,18.0)"},"localizedResources":[{"language":"en-us","title":"C++/CLI support for v143 build tools (14.32-17.2) (Out of support)","description":"Required tools and frameworks for code editing and debugging C++/CLI applications using the .NET framework. End of support: January 2024","category":"Compilers, build tools, and runtimes"},{"language":"zh-cn","title":"适用于 v143 生成工具的 C++/CLI 支持(14.32-17.2)(不受支持)","description":"使用 .NET Framework 进行 C++/CLI 应用程序的代码编辑和调试所需的工具和框架。终止支持: 2024 年 1 月","category":"编译器、生成工具和运行时"},{"language":"zh-tw","title":"v143 組建工具 (14.32-17.2) 的 C++/CLI 支援 (不再支援)","description":"使用 .NET Framework 進行 C++/CLI 應用程式程式碼編輯與偵錯的必要工具與架構。終止支援: 2024 年 1 月","category":"編譯器、建置工具和執行階段"},{"language":"cs-cz","title":"Podpora C++/CLI pro nástroje sestavení v143 (14.32-17.2) (podpora skončila)","description":"Požadované nástroje a rozhraní pro úpravy kódu a ladění aplikací C++/CLI pomocí rozhraní .NET Framework. Konec podpory: leden 2024","category":"Kompilátory, nástroje pro sestavování buildů a moduly runtime"},{"language":"de-de","title":"C++-/CLI-Unterstützung für v143-Buildtools (14.32-17.2) (Nicht mehr unterstützt)","description":"Erforderliche Tools und Frameworks für die Codebearbeitung und das Debuggen von C++-/CLI-Anwendungen mithilfe von .NET Framework. Ende des Supports: Januar 2024","category":"Compiler, Buildtools und Runtimes"},{"language":"es-es","title":"Compatibilidad de C++/CLI con las herramientas de compilación v143 (14.32-17.2) (sin soporte técnico)","description":"Herramientas y marcos de trabajo necesarios para la edición y depuración de código de aplicaciones C++/CLI con .NET Framework. Finalización del soporte: enero de 2024","category":"Compiladores, herramientas de compilación y entornos de ejecución"},{"language":"fr-fr","title":"Prise en charge C++/CLI pour les outils de build v143 (14.32-17.2) (sans prise en charge)","description":"Outils et frameworks nécessaires pour modifier le code et déboguer les applications C++/CLI à l'aide du .NET Framework. Fin du support : janvier 2024","category":"Compilateurs, outils de génération et runtime"},{"language":"it-it","title":"Supporto di C++/CLI per gli strumenti di compilazione v143 (14.32-17.2) (supporto non disponibile)","description":"Strumenti e framework necessari per la modifica del codice e il debug di applicazioni C++/CLI con .NET Framework. Fine del supporto: gennaio 2024","category":"Compilatori, strumenti di compilazione e runtime"},{"language":"ja-jp","title":"v143 ビルド ツールの C++/CLI サポート (14.32-17.2) (サポート対象外)","description":".NET Framework を使用して C++/CLI アプリケーションのコード編集やデバッグを行うために必要なツールとフレームワーク。サポート終了: 2024 年 1 月","category":"コンパイラ、ビルド ツール、およびランタイム"},{"language":"ko-kr","title":"v143 빌드 도구(14.32-17.2)에 대한 C++/CLI 지원(지원 중단)","description":".NET Framework를 사용한 C++/CLI 애플리케이션 디버깅 및 코드 편집을 위해 필요한 도구 및 프레임워크입니다. 지원 종료일: 2024년 1월","category":"컴파일러, 빌드 도구 및 런타임"},{"language":"pl-pl","title":"Obsługa języka C++/CLI dla narzędzi kompilacji w wersji 143 (14.32-17.2) (koniec wsparcia)","description":"Wymagane narzędzia i platformy na potrzeby edytowania kodu i debugowania aplikacji C++/CLI przy użyciu platformy .NET Framework. Koniec wsparcia technicznego: styczeń 2024 r.","category":"Kompilatory, narzędzia do kompilacji i środowiska uruchomieniowe"},{"language":"pt-br","title":"Suporte C++/CLI para ferramentas de compilação v143 (14.32-17.2) (Sem de suporte)","description":"Ferramentas e estruturas necessárias para edição de código e depuração de aplicativos C++/CLI usando o .NET Framework. Fim do suporte: janeiro de 2024","category":"Compiladores, ferramentas de build e tempos de execução"},{"language":"ru-ru","title":"Поддержка C++/CLI для инструментов сборки v143 (14.32–17.2) (не поддерживается)","description":"Необходимые инструменты и платформы для редактирования кода и отладки приложений на C++ и консольных приложений, использующих платформу .NET Framework. Окончание поддержки: январь 2024 г.","category":"Компиляторы, средства сборки и среды выполнения"},{"language":"tr-tr","title":"v143 derleme araçları (14.32-17.2) için C++/CLI desteği (Destek dışı)","description":".NET Framework kullanarak C++/CLI uygulamalarında kod düzenleme ve hata ayıklama için gereken araçlar ve çerçeveler. Destek sonu: Ocak 2024","category":"Derleyiciler, derleme araçları ve çalışma zamanları"}]},{"id":"Microsoft.VisualStudio.Component.VC.14.32.17.2.MFC","version":"17.13.35710.127","type":"Component","automaticallyAddedByExtensionPack":false,"outOfSupport":true,"dependencies":{"Microsoft.VisualStudio.Component.VC.14.32.17.2.ATL":"[17.0,18.0)","Microsoft.VC.14.32.17.2.MFC.Headers":"[14.0,18.0)","Microsoft.VC.14.32.17.2.MFC.MBCS":"[14.0,18.0)","Microsoft.VC.14.32.17.2.MFC.MBCS.x64":"[14.0,18.0)","Microsoft.VC.14.32.17.2.MFC.Redist.X64":"[14.0,18.0)","Microsoft.VC.14.32.17.2.MFC.Redist.X86":"[14.0,18.0)","Microsoft.VC.14.32.17.2.MFC.Source":"[14.0,18.0)","Microsoft.VC.14.32.17.2.MFC.x64":"[14.0,18.0)","Microsoft.VC.14.32.17.2.MFC.x86":"[14.0,18.0)","Microsoft.VisualStudio.VC.Ide.MFC_-104079356":{"id":"Microsoft.VisualStudio.VC.Ide.MFC","version":"[17.0,18.0)","when":["Microsoft.VisualStudio.Product.Enterprise","Microsoft.VisualStudio.Product.Professional","Microsoft.VisualStudio.Product.Community"]},"Microsoft.VisualCpp.HTMLHelpWorkshop.Msi":"[4.0,5.0)"},"localizedResources":[{"language":"en-us","title":"C++ v14.32 (17.2) MFC for v143 build tools (x86 & x64) (Out of support)","description":"Includes headers and libraries for the development of MFC applications including the Multi-byte Character Set (MBCS). End of support: January 2024","category":"SDKs, libraries, and frameworks"},{"language":"zh-cn","title":"适用于 v143 生成工具的 C++ v14.32 (17.2) MFC (x86 和 x64)(不受支持)","description":"包括用于开发 MFC 应用程序的标头和库，包含多字节字符集(MBCS)。终止支持: 2024 年 1 月","category":"SDK、库和框架"},{"language":"zh-tw","title":"適用於 v143 組建工具的 C++ v14.32 (17.2) MFC (x86 和 x64) (不再支援)","description":"包含用於開發 MFC 應用程式的標頭與程式庫，包含多位元組字元集 (MBCS)。終止支援: 2024 年 1 月","category":"SDK、程式庫和架構"},{"language":"cs-cz","title":"C++ v14.32 (17.2) MFC pro nástroje sestavení v143 (x86 a x64) (podpora skončila)","description":"Obsahuje hlavičky a knihovny pro vývoj aplikací MFC, včetně vícebajtové znakové sady (MBCS). Konec podpory: leden 2024","category":"Sady SDK, knihovny a architektury"},{"language":"de-de","title":"C++ v14.32 (17.2) MFC für v143-Buildtools (x86 und x64) (Nicht mehr unterstützt)","description":"Umfasst Header und Bibliotheken für die Entwicklung von MFC-Anwendungen einschließlich Multibyte-Zeichensatz (MBCS). Ende des Supports: Januar 2024","category":"SDKs, Bibliotheken und Frameworks"},{"language":"es-es","title":"C++ v14.32 (17.2) MFC para las herramientas de compilación v143 (x64 y x86) (sin soporte técnico)","description":"Incluye encabezados y bibliotecas para el desarrollo de aplicaciones MFC, incluido el juego de caracteres multibyte (MBCS). Finalización del soporte: enero de 2024","category":"SDK, bibliotecas y marcos"},{"language":"fr-fr","title":"C++ v14.32 (17.2) MFC pour les outils de build v143 (x86 et x64) (sans prise en charge)","description":"Inclut des en-têtes et des bibliothèques pour le développement d'applications MFC, notamment le jeu de caractères multioctets (MBCS). Fin du support : janvier 2024","category":"SDK, bibliothèques et frameworks"},{"language":"it-it","title":"MFC C++ v14.32 (17.2) per gli strumenti di compilazione v143 (x86 e x64) (supporto non disponibile)","description":"Include intestazioni e librerie per lo sviluppo di applicazioni MFC, incluso il set di caratteri multibyte (MBCS). Fine del supporto: gennaio 2024","category":"SDK, librerie e framework"},{"language":"ja-jp","title":"v143 ビルド ツール (x86 および x64) 用 C++ v14.32 (17.2) MFC (サポート対象外)","description":"マルチ バイト文字セット (MBCS) を含む MFC アプリケーションの開発用ヘッダーとライブラリが含まれます。サポート終了: 2024 年 1 月","category":"SDK、ライブラリ、およびフレームワーク"},{"language":"ko-kr","title":"v143 빌드 도구용 C++ v14.32(17.2) MFC(x86 & x64)(지원 중단)","description":"MBCS(멀티바이트 문자 집합)를 비롯하여 MFC 애플리케이션 개발에 필요한 헤더와 라이브러리를 포함합니다. 지원 종료일: 2024년 1월","category":"SDK, 라이브러리 및 프레임워크"},{"language":"pl-pl","title":"C++ w wersji 14.32 (17.2) MFC dla narzędzi kompilacji w wersji 143 (x86 i x64) (zakończono wsparcie)","description":"Zawiera nagłówki i biblioteki na potrzeby programowania aplikacji MFC, w tym zestaw znaków wielobajtowych (MBCS). Koniec wsparcia technicznego: styczeń 2024 r.","category":"Zestawy SDK, biblioteki i struktury"},{"language":"pt-br","title":"C++ v14.32 (17.2) MFC para ferramentas de compilação v143 (x86 e x64) (Sem suporte)","description":"Inclui cabeçalhos e bibliotecas para o desenvolvimento de aplicativos MFC, incluindo o Conjunto de Caracteres Multibyte (MBCS). Fim do suporte: janeiro de 2024","category":"SDKs, bibliotecas e estruturas"},{"language":"ru-ru","title":"C++ v14.32 (17.2) MFC для инструментов сборки v143 (x86 и x64) (не поддерживается)","description":"Включает заголовки и библиотеки для разработки приложений MFC, включая многобайтовую кодировку (MBCS). Окончание поддержки: январь 2024 г.","category":"Пакеты SDK, библиотеки и платформы"},{"language":"tr-tr","title":"v143 derleme araçları için C++ v14.32 (17.2) MFC (x86 ve x64) (Destek dışı)","description":"Çok Baytlı Karakter Kümesi (MBCS) dahil olmak üzere MFC uygulamaları geliştirmeye yönelik üst bilgileri ve kitaplıkları içerir. Destek sonu: Ocak 2024","category":"SDK'lar, kitaplıklar ve çerçeveler"}]},{"id":"Microsoft.VisualStudio.Component.VC.14.32.17.2.MFC.ARM","version":"17.13.35710.127","type":"Component","automaticallyAddedByExtensionPack":false,"outOfSupport":true,"dependencies":{"Microsoft.VisualStudio.Component.VC.14.32.17.2.ATL.ARM":"[17.0,18.0)","Microsoft.VC.14.32.17.2.MFC.ARM":"[14.0,18.0)","Microsoft.VC.14.32.17.2.MFC.Headers":"[14.0,18.0)","Microsoft.VC.14.32.17.2.MFC.MBCS.arm":"[14.0,18.0)","Microsoft.VC.14.32.17.2.MFC.Redist.ARM":"[14.0,18.0)","Microsoft.VC.14.32.17.2.MFC.Source":"[14.0,18.0)","Microsoft.VisualStudio.VC.Ide.MFC_-104079356":{"id":"Microsoft.VisualStudio.VC.Ide.MFC","version":"[17.0,18.0)","when":["Microsoft.VisualStudio.Product.Enterprise","Microsoft.VisualStudio.Product.Professional","Microsoft.VisualStudio.Product.Community"]},"Microsoft.VisualCpp.HTMLHelpWorkshop.Msi":"[4.0,5.0)"},"localizedResources":[{"language":"en-us","title":"C++ v14.32 (17.2) MFC for v143 build tools (ARM) (Out of support)","description":"Includes headers and libraries for the development of MFC applications including the Multi-byte Character Set (MBCS) targeting ARM. End of support: January 2024","category":"SDKs, libraries, and frameworks"},{"language":"zh-cn","title":"适用于 v143 生成工具的 C++ v14.32 (17.2) MFC (ARM)(不受支持)","description":"包括用于开发 MFC 应用程序的标头和库，包含面向 ARM 的多字节字符集(MBCS)。终止支持: 2024 年 1 月","category":"SDK、库和框架"},{"language":"zh-tw","title":"適用於 v143 組建工具的 C++ v14.32 (17.2) MFC (ARM) (不再支援)","description":"包含用於開發 MFC 應用程式的標頭與程式庫，包含以 ARM 為目標的多位元組字元集 (MBCS)。終止支援: 2024 年 1 月","category":"SDK、程式庫和架構"},{"language":"cs-cz","title":"C++ v14.32 (17.2) MFC pro nástroje sestavení v143 (ARM) (podpora skončila)","description":"Obsahuje hlavičky a knihovny pro vývoj aplikací MFC, včetně vícebajtové znakové sady (MBCS) s cílením na ARM. Konec podpory: leden 2024","category":"Sady SDK, knihovny a architektury"},{"language":"de-de","title":"C++ v14.32 (17.2) MFC für v143-Buildtools (ARM) (Nicht mehr unterstützt)","description":"Umfasst Header und Bibliotheken für die Entwicklung von MFC-Anwendungen einschließlich Multibyte-Zeichensatz (MBCS) für ARM. Ende des Supports: Januar 2024","category":"SDKs, Bibliotheken und Frameworks"},{"language":"es-es","title":"C++ v14.32 (17.2) MFC para herramientas de compilación v143 (ARM) (sin soporte técnico)","description":"Incluye encabezados y bibliotecas para el desarrollo de aplicaciones MFC, incluido el juego de caracteres multibyte (MBCS) destinado a ARM. Finalización del soporte: enero de 2024","category":"SDK, bibliotecas y marcos"},{"language":"fr-fr","title":"C++ v14.32 (17.2) MFC pour les outils de build v143 (ARM) (hors prise en charge)","description":"Inclut des en-têtes et des bibliothèques pour le développement d'applications MFC, notamment le jeu de caractères multioctets (MBCS) ciblant ARM. Fin du support : janvier 2024","category":"SDK, bibliothèques et frameworks"},{"language":"it-it","title":"MFC ++ v14.32 (17.2) per strumenti di compilazione v143 (ARM) (Supporto non disponibile)","description":"Include intestazioni e librerie per lo sviluppo di applicazioni MFC, incluso il set di caratteri multibyte (MBCS), destinate ad ARM. Fine del supporto: gennaio 2024","category":"SDK, librerie e framework"},{"language":"ja-jp","title":"v143 ビルド ツール用 C++ v14.32 (17.2) MFC (ARM) (サポート対象外)","description":"ARM をターゲットにしたマルチ バイト文字セット (MBCS) を含む MFC アプリケーションの開発用ヘッダーとライブラリが含まれます。サポート終了: 2024 年 1 月","category":"SDK、ライブラリ、およびフレームワーク"},{"language":"ko-kr","title":"v143 빌드 도구(ARM)용 C++ v14.32 (17.2) MFC(지원되지 않음)","description":"ARM을 대상으로 하는 MBCS(멀티바이트 문자 집합)를 비롯하여 MFC 애플리케이션 개발을 위한 헤더와 라이브러리를 포함합니다. 지원 종료일: 2024년 1월","category":"SDK, 라이브러리 및 프레임워크"},{"language":"pl-pl","title":"Klasa MFC języka C++ w wersji 14.32 (17.2) dla narzędzi kompilacji w wersji 143 (ARM) (koniec wsparcia)","description":"Zawiera nagłówki i biblioteki na potrzeby programowania aplikacji MFC, łącznie z wielobajtowym zestawem znaków (MBCS) przeznaczonym dla architektury ARM. Koniec wsparcia technicznego: styczeń 2024 r.","category":"Zestawy SDK, biblioteki i struktury"},{"language":"pt-br","title":"C++ v14.32 (17.2) MFC para ferramentas de build (ARM) v143 (sem suporte)","description":"Inclui cabeçalhos e bibliotecas para o desenvolvimento de aplicativos MFC, incluindo o Conjunto de Caracteres Multibyte (MBCS) direcionado ao ARM. Fim do suporte: janeiro de 2024","category":"SDKs, bibliotecas e estruturas"},{"language":"ru-ru","title":"MFC-библиотека C++ версии 14.32 (17.2) для средств сборки версии 143 (ARM) (поддержка прекращена)","description":"Включает заголовки и библиотеки для разработки приложений MFC, включая многобайтовую кодировку (MBCS) для целевой платформы ARM. Окончание поддержки: январь 2024 г.","category":"Пакеты SDK, библиотеки и платформы"},{"language":"tr-tr","title":"v143 derleme araçları (ARM) için C++ v14.32 (17.2) MFC (Destek dışı)","description":"ARM'yi hedefleyen Çok Baytlı Karakter Kümesi (MBCS) dahil olmak üzere MFC uygulamaları geliştirmeye yönelik üst bilgileri ve kitaplıkları içerir. Destek sonu: Ocak 2024","category":"SDK'lar, kitaplıklar ve çerçeveler"}]},{"id":"Microsoft.VisualStudio.Component.VC.14.32.17.2.MFC.ARM.Spectre","version":"17.13.35710.127","type":"Component","automaticallyAddedByExtensionPack":false,"outOfSupport":true,"dependencies":{"Microsoft.VisualStudio.Component.VC.14.32.17.2.ATL.ARM.Spectre":"[17.0,18.0)","Microsoft.VC.14.32.17.2.MFC.ARM.Spectre":"[14.0,18.0)","Microsoft.VC.14.32.17.2.MFC.Headers":"[14.0,18.0)","Microsoft.VC.14.32.17.2.MFC.MBCS.ARM.Spectre":"[14.0,18.0)","Microsoft.VC.14.32.17.2.MFC.Redist.ARM.Spectre":"[14.0,18.0)","Microsoft.VC.14.32.17.2.MFC.Source":"[14.0,18.0)","Microsoft.VisualStudio.VC.Ide.MFC_-104079356":{"id":"Microsoft.VisualStudio.VC.Ide.MFC","version":"[17.0,18.0)","when":["Microsoft.VisualStudio.Product.Enterprise","Microsoft.VisualStudio.Product.Professional","Microsoft.VisualStudio.Product.Community"]},"Microsoft.VisualCpp.HTMLHelpWorkshop.Msi":"[4.0,5.0)"},"localizedResources":[{"language":"en-us","title":"C++ v14.32 (17.2) MFC for v143 build tools with Spectre Mitigations (ARM) (Out of support)","description":"Includes headers and libraries with Spectre Mitigations for the development of MFC applications including the Multi-byte Character Set (MBCS) targeting ARM. End of support: January 2024","category":"SDKs, libraries, and frameworks"},{"language":"zh-cn","title":"带有 Spectre 缓解措施适用于 v143 生成工具的 C++ v14.32 (17.2) MFC (ARM)(不受支持)","description":"包括带有 Spectre 缓解措施的标头和库，用于开发包括面向 ARM 的多字节字符集(MBCS)的 MFC 应用程序。终止支持: 2024 年 1 月","category":"SDK、库和框架"},{"language":"zh-tw","title":"適用於 v143 組建工具且具有 Spectre 風險降低功能的 C++ v14.32 (17.2) MFC (ARM) (不再支援)","description":"包含用於開發 MFC 應用程式的標頭與程式庫及 Spectre 風險降低，包含以 ARM 為目標的多位元組字元集 (MBCS)。終止支援: 2024 年 1 月","category":"SDK、程式庫和架構"},{"language":"cs-cz","title":"C++ v14.32 (17.2) MFC pro nástroje sestavení v143 se zmírněními hrozeb Spectre (ARM) (podpora skončila)","description":"Obsahuje hlavičky a knihovny se zmírněními hrozeb Spectre pro vývoj aplikací MFC, včetně vícebajtové znakové sady (MBCS) s cílením na ARM. Konec podpory: leden 2024","category":"Sady SDK, knihovny a architektury"},{"language":"de-de","title":"C++ v14.32 (17.2) MFC für v143-Buildtools mit Spectre-Entschärfungen (ARM) (Nicht mehr unterstützt)","description":"Umfasst Header und Bibliotheken mit Spectre-Entschärfungen für die Entwicklung von MFC-Anwendungen einschließlich Multibyte-Zeichensatz (MBCS) für ARM. Ende des Supports: Januar 2024","category":"SDKs, Bibliotheken und Frameworks"},{"language":"es-es","title":"Herramientas de compilación MFC para v143 de C++ v14.32 (17.2) con mitigaciones de Spectre (ARM) (sin soporte técnico)","description":"Incluye encabezados y bibliotecas con mitigaciones de Spectre para el desarrollo de aplicaciones MFC, incluido el juego de caracteres multibyte (MBCS) destinado a ARM. Finalización del soporte: enero de 2024","category":"SDK, bibliotecas y marcos"},{"language":"fr-fr","title":"C++ v14.32 (17.2) MFC pour les outils de build v143 avec atténuations de Spectre (ARM) (sans prise en charge)","description":"Inclut des en-têtes et des bibliothèques avec atténuations Spectre pour le développement d'applications MFC, notamment le jeu de caractères multioctets (MBCS) ciblant ARM. Fin du support : janvier 2024","category":"SDK, bibliothèques et frameworks"},{"language":"it-it","title":"MFC C++ v14.32 (17.2) per gli strumenti di compilazione v143 con mitigazioni Spectre (ARM) (supporto non disponibile)","description":"Include intestazioni e librerie con mitigazioni Spectre per lo sviluppo di applicazioni MFC, incluso il set di caratteri multibyte (MBCS), destinate ad ARM. Fine del supporto: gennaio 2024","category":"SDK, librerie e framework"},{"language":"ja-jp","title":"Spectre 軽減策を備えた v143 ビルド ツール (ARM) 用の C++ v14.32 (17.2) MFC (サポート対象外)","description":"ARM をターゲットにしたマルチ バイト文字セット (MBCS) を含む MFC アプリケーションを開発するための、Spectre の軽減策を含むヘッダーとライブラリが含まれます。サポート終了: 2024 年 1 月","category":"SDK、ライブラリ、およびフレームワーク"},{"language":"ko-kr","title":"Spectre 완화 기능이 포함된 v143 빌드 도구용 C++ v14.32(17.2) MFC(ARM)(지원 중단)","description":"ARM을 대상으로 하는 MBCS(멀티바이트 문자 집합)를 비롯하여 MFC 애플리케이션 개발을 위해 Spectre 완화 기능을 사용하는 헤더와 라이브러리를 포함합니다. 지원 종료일: 2024년 1월","category":"SDK, 라이브러리 및 프레임워크"},{"language":"pl-pl","title":"Klasy MFC języka C++ w wersji 14.32 (17.2) dla narzędzi kompilacji w wersji 143 z ograniczeniami ryzyka Spectre (ARM) (koniec wsparcia)","description":"Zawiera nagłówki i biblioteki ze środkami zaradczymi dla luki Spectre na potrzeby programowania aplikacji MFC, łącznie z wielobajtowym zestawem znaków (MBCS) przeznaczonym dla architektury ARM. Koniec wsparcia technicznego: styczeń 2024 r.","category":"Zestawy SDK, biblioteki i struktury"},{"language":"pt-br","title":"C++ v14.32 (17.2) MFC para ferramentas de compilação v143 com Mitigações contra Spectre (ARM) (Sem suporte)","description":"Inclui cabeçalhos e bibliotecas com Mitigações do Spectre para o desenvolvimento de aplicativos MFC, incluindo o Conjunto de Caracteres Multibyte (MBCS) direcionado ao ARM. Fim do suporte: janeiro de 2024","category":"SDKs, bibliotecas e estruturas"},{"language":"ru-ru","title":"C++ v14.32 (17.2) MFC для инструментов сборки v143 со средствами защиты от Spectre (ARM) (не поддерживается)","description":"Включает заголовки и библиотеки с устранением рисков Spectre для разработки приложений MFC, включая многобайтовую кодировку (MBCS) для целевой платформы ARM. Окончание поддержки: январь 2024 г.","category":"Пакеты SDK, библиотеки и платформы"},{"language":"tr-tr","title":"Spectre Risk Azaltmaları içeren v143 derleme araçları için C++ v14.32 (17.2) MFC (ARM) (Destek dışı)","description":"ARM'yi hedefleyen Çok Baytlı Karakter Kümesi (MBCS) dahil olmak üzere MFC uygulamaları geliştirmeye yönelik Spectre Risk Azaltmalarının bulunduğu üst bilgileri ve kitaplıkları içerir. Destek sonu: Ocak 2024","category":"SDK'lar, kitaplıklar ve çerçeveler"}]},{"id":"Microsoft.VisualStudio.Component.VC.14.32.17.2.MFC.ARM64","version":"17.13.35710.127","type":"Component","automaticallyAddedByExtensionPack":false,"outOfSupport":true,"dependencies":{"Microsoft.VisualStudio.Component.VC.14.32.17.2.ATL.ARM64":"[17.0,18.0)","Microsoft.VC.14.32.17.2.MFC.ARM64":"[14.0,18.0)","Microsoft.VC.14.32.17.2.MFC.Headers":"[14.0,18.0)","Microsoft.VC.14.32.17.2.MFC.MBCS.ARM64":"[14.0,18.0)","Microsoft.VC.14.32.17.2.MFC.Redist.ARM64":"[14.0,18.0)","Microsoft.VC.14.32.17.2.MFC.Source":"[14.0,18.0)","Microsoft.VisualStudio.VC.Ide.MFC_-104079356":{"id":"Microsoft.VisualStudio.VC.Ide.MFC","version":"[17.0,18.0)","when":["Microsoft.VisualStudio.Product.Enterprise","Microsoft.VisualStudio.Product.Professional","Microsoft.VisualStudio.Product.Community"]},"Microsoft.VisualCpp.HTMLHelpWorkshop.Msi":"[4.0,5.0)"},"localizedResources":[{"language":"en-us","title":"C++ v14.32 (17.2) MFC for v143 build tools (ARM64) (Out of support)","description":"Includes headers and libraries for the development of MFC applications including the Multi-byte Character Set (MBCS) targeting ARM64. End of support: January 2024","category":"SDKs, libraries, and frameworks"},{"language":"zh-cn","title":"适用于 v143 生成工具的 C++ v14.32 (17.2) MFC (ARM64)(不受支持)","description":"包括用于开发 MFC 应用程序的标头和库，包括面向 ARM64 的多字节字符集(MBCS)。终止支持: 2024 年 1 月","category":"SDK、库和框架"},{"language":"zh-tw","title":"適用於 v143 組建工具的 C++ v14.32 (17.2) MFC (ARM64) (不再支援)","description":"包含用於開發 MFC 應用程式的標頭與程式庫，包含以 ARM64 為目標的多位元組字元集 (MBCS)。終止支援: 2024 年 1 月","category":"SDK、程式庫和架構"},{"language":"cs-cz","title":"C++ v14.32 (17.2) MFC pro nástroje sestavení v143 (ARM64) (podpora skončila)","description":"Obsahuje hlavičky a knihovny pro vývoj aplikací MFC, včetně vícebajtové znakové sady (MBCS) s cílením na ARM64. Konec podpory: leden 2024","category":"Sady SDK, knihovny a architektury"},{"language":"de-de","title":"C++ v14.32 (17.2) MFC für v143-Buildtools (ARM64) (Nicht mehr unterstützt)","description":"Umfasst Header und Bibliotheken für die Entwicklung von MFC-Anwendungen einschließlich Multibyte-Zeichensatz (MBCS) für ARM64. Ende des Supports: Januar 2024","category":"SDKs, Bibliotheken und Frameworks"},{"language":"es-es","title":"MFC para herramientas de compilación de C++ v14.32 (17.2) para v143 (ARM64) (sin soporte técnico)","description":"Incluye encabezados y bibliotecas para el desarrollo de aplicaciones MFC, incluido el juego de caracteres multibyte (MBCS) destinado a ARM64. Finalización del soporte: enero de 2024","category":"SDK, bibliotecas y marcos"},{"language":"fr-fr","title":"C++ v14.32 (17.2) MFC pour les outils de build v143 (ARM64) (sans prise en charge)","description":"Inclut des en-têtes et des bibliothèques pour le développement d'applications MFC, notamment le jeu de caractères multioctets (MBCS) ciblant ARM64. Fin du support : janvier 2024","category":"SDK, bibliothèques et frameworks"},{"language":"it-it","title":"MFC C++ v14.32 (17.2) per strumenti di compilazione v143 (ARM64) (supporto non disponibile)","description":"Include intestazioni e librerie per lo sviluppo di applicazioni MFC, incluso il set di caratteri multibyte (MBCS), destinate ad ARM64. Fine del supporto: gennaio 2024","category":"SDK, librerie e framework"},{"language":"ja-jp","title":"v143 ビルド ツール (ARM64) 用の C++ v14.32 (17.2) MFC (サポート対象外)","description":"ARM64 をターゲットにしたマルチ バイト文字セット (MBCS) を含む MFC アプリケーションの開発用ヘッダーとライブラリが含まれます。サポート終了: 2024 年 1 月","category":"SDK、ライブラリ、およびフレームワーク"},{"language":"ko-kr","title":"V143 빌드 도구용 C++ v14.32(17.2) MFC(ARM64)(지원 중단)","description":"ARM64를 대상으로 하는 MBCS(멀티바이트 문자 집합)를 비롯하여 MFC 애플리케이션 개발에 필요한 헤더와 라이브러리를 포함합니다. 지원 종료일: 2024년 1월","category":"SDK, 라이브러리 및 프레임워크"},{"language":"pl-pl","title":"Klasy MFC języka C++ w wersji 14.32 (17.2) dla narzędzi kompilacji w wersji 143 (ARM64) (zakończono wsparcie)","description":"Zawiera nagłówki i biblioteki na potrzeby programowania aplikacji MFC, łącznie z wielobajtowym zestawem znaków (MBCS) przeznaczonym dla architektury ARM64. Koniec wsparcia technicznego: styczeń 2024 r.","category":"Zestawy SDK, biblioteki i struktury"},{"language":"pt-br","title":"C++ v14.32 (17.2) MFC para ferramentas de compilação v143 (ARM64) (Sem de suporte)","description":"Inclui cabeçalhos e bibliotecas para o desenvolvimento de aplicativos MFC, incluindo o Conjunto de Caracteres Multibyte (MBCS) direcionado ao ARM64. Fim do suporte: janeiro de 2024","category":"SDKs, bibliotecas e estruturas"},{"language":"ru-ru","title":"C++ v14.32 (17.2) MFC для инструментов сборки v143 (ARM64) (не поддерживается)","description":"Включает заголовки и библиотеки для разработки приложений MFC, включая многобайтовую кодировку (MBCS) для целевой платформы ARM64. Окончание поддержки: январь 2024 г.","category":"Пакеты SDK, библиотеки и платформы"},{"language":"tr-tr","title":"v143 derleme araçları için C++ v14.32 (17.2) MFC (ARM64) (Destek dışı)","description":"ARM64'ü hedefleyen Çok Baytlı Karakter Kümesi (MBCS) dahil olmak üzere MFC uygulamaları geliştirmeye yönelik üst bilgileri ve kitaplıkları içerir. Destek sonu: Ocak 2024","category":"SDK'lar, kitaplıklar ve çerçeveler"}]},{"id":"Microsoft.VisualStudio.Component.VC.14.32.17.2.MFC.ARM64.Spectre","version":"17.13.35710.127","type":"Component","automaticallyAddedByExtensionPack":false,"outOfSupport":true,"dependencies":{"Microsoft.VisualStudio.Component.VC.14.32.17.2.ATL.ARM64.Spectre":"[17.0,18.0)","Microsoft.VC.14.32.17.2.MFC.ARM64.Spectre":"[14.0,18.0)","Microsoft.VC.14.32.17.2.MFC.Headers":"[14.0,18.0)","Microsoft.VC.14.32.17.2.MFC.MBCS.ARM64.Spectre":"[14.0,18.0)","Microsoft.VC.14.32.17.2.MFC.Redist.ARM64.Spectre":"[14.0,18.0)","Microsoft.VC.14.32.17.2.MFC.Source":"[14.0,18.0)","Microsoft.VisualStudio.VC.Ide.MFC_-104079356":{"id":"Microsoft.VisualStudio.VC.Ide.MFC","version":"[17.0,18.0)","when":["Microsoft.VisualStudio.Product.Enterprise","Microsoft.VisualStudio.Product.Professional","Microsoft.VisualStudio.Product.Community"]},"Microsoft.VisualCpp.HTMLHelpWorkshop.Msi":"[4.0,5.0)"},"localizedResources":[{"language":"en-us","title":"C++ v14.32 (17.2) MFC for v143 build tools with Spectre Mitigations (ARM64) (Out of support)","description":"Includes headers and libraries with Spectre mitigations for the development of MFC applications including the Multi-byte Character Set (MBCS) targeting ARM64. End of support: January 2024","category":"SDKs, libraries, and frameworks"},{"language":"zh-cn","title":"带有 Spectre 缓解措施适用于 v143 生成工具的 C++ v14.32 (17.2) MFC (ARM64)(不受支持)","description":"包括带有 Spectre 缓解措施的标头和库，用于开发包括面向 ARM64 的多字节字符集(MBCS)的 MFC 应用程序。终止支持: 2024 年 1 月","category":"SDK、库和框架"},{"language":"zh-tw","title":"適用於 v143 組建工具且具有 Spectre 風險降低功能的 C++ v14.32 (17.2) MFC (ARM64) (不再支援)","description":"包含用於開發 MFC 應用程式的標頭與程式庫及 Spectre 風險降低，包含以 ARM64 為目標的多位元組字元集 (MBCS)。終止支援: 2024 年 1 月","category":"SDK、程式庫和架構"},{"language":"cs-cz","title":"C++ v14.32 (17.2) MFC pro nástroje sestavení v143 se zmírněními hrozeb Spectre (ARM64) (podpora sk