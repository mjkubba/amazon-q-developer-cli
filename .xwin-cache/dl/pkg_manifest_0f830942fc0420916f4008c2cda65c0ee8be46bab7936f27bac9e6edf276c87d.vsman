},{"language":"cs-cz","title":"Vývoj desktopových aplikací pomocí .NET","description":"Umožňuje kompilovat aplikace WPF, Windows Forms a konzolové aplikace pomocí jazyků C#, Visual Basic a F# s použitím technologií .NET a .NET Framework.","category":"Desktopové a mobilní platformy"},{"language":"de-de","title":".NET-Desktopentwicklung","description":"Hiermit erstellen Sie WPF-, Windows Forms- und Konsolenanwendungen mithilfe von C#, Visual Basic und F# mit .NET und .NET Framework.","category":"Desktop- und Mobilgeräte"},{"language":"es-es","title":"Desarrollo de escritorio de .NET","description":"Compila WPF, Windows Forms y aplicaciones de consola mediante C#, Visual Basic y F# con .NET y .NET Framework.","category":"Móviles y de escritorio"},{"language":"fr-fr","title":"Développement .NET Desktop","description":"Créez des WPF, des Windows Forms et des applications console à l’aide de C#, de Visual Basic, ainsi que de F# avec .NET et .NET Framework.","category":"Bureau et mobile"},{"language":"it-it","title":"Sviluppo per desktop .NET","description":"Consente di creare applicazioni WPF, Windows Form e console con C#, Visual Basic e F# con .NET e .NET Framework.","category":"Desktop e dispositivi mobili"},{"language":"ja-jp","title":".NET デスクトップ開発","description":".NET と .NET Framework と共に C#、Visual Basic、F# を使用して、WPF、Windows フォーム、コンソール アプリケーションをビルドします。","category":"デスクトップとモバイル"},{"language":"ko-kr","title":".NET 데스크톱 개발","description":".NET 및 .NET Framework와 함께 C#, Visual Basic 및 F#을 사용하여 WPF, Windows Forms 및 콘솔 애플리케이션을 빌드합니다.","category":"데스크톱 및 모바일"},{"language":"pl-pl","title":"Programowanie aplikacji klasycznych dla platformy .NET","description":"Twórz aplikacje WPF i Windows Forms oraz aplikacje konsolowe przy użyciu języków C#, Visual Basic i F# za pomocą platform .NET i .NET Framework.","category":"Komputery i urządzenia przenośne"},{"language":"pt-br","title":"Desenvolvimento para desktop com .NET","description":"Crie WPF, Windows Forms e aplicativos de console usando C#, Visual Basic e F# com .NET e .NET Framework.","category":"Área de trabalho e Dispositivos móveis"},{"language":"ru-ru","title":"Разработка классических приложений .NET","description":"Создание приложений WPF, Windows Forms и консольных приложений с использованием C#, Visual Basic и F# в .NET и .NET Framework.","category":"Классические и мобильные приложения"},{"language":"tr-tr","title":".NET masaüstü geliştirme","description":".NET ve .NET Framework ile C#, Visual Basic ve F# dillerini kullanarak WPF, Windows Forms ve konsol uygulamaları derleyin.","category":"Masaüstü ve Mobil"}]},{"id":"Microsoft.VisualStudio.Workload.ManagedDesktop","version":"17.13.35710.127","type":"Workload","productArch":"x64","icon":{"mimeType":"image/svg+xml","base64":""},"dependencies":{"Microsoft.VisualStudio.Component.ManagedDesktop.Prerequisites":"[17.0,18.0)","Microsoft.Net.ComponentGroup.DevelopmentPrerequisites":"[17.0,18.0)","Microsoft.VisualStudio.Component.Roslyn.LanguageServices":"[17.0,18.0)","Microsoft.VisualStudio.PackageGroup.Interactive":"[17.0,18.0)","Microsoft.NetCore.Component.DevelopmentTools":{"version":"[17.0,18.0)","type":"Recommended"},"Microsoft.Net.ComponentGroup.4.8.DeveloperTools":{"version":"[17.0,18.0)","type":"Recommended"},"Microsoft.VisualStudio.Component.EntityFramework":{"version":"[17.0,18.0)","type":"Recommended"},"Microsoft.VisualStudio.Component.DiagnosticTools":{"version":"[17.0,18.0)","type":"Recommended"},"Microsoft.VisualStudio.Component.IntelliCode":{"version":"[17.0,18.0)","type":"Recommended"},"Microsoft.VisualStudio.Component.IntelliTrace.FrontEnd_1779377902":{"id":"Microsoft.VisualStudio.Component.IntelliTrace.FrontEnd","version":"[17.0,18.0)","type":"Recommended","when":["Microsoft.VisualStudio.Product.EnterpriseX86","Microsoft.VisualStudio.Product.Enterprise"]},"Microsoft.VisualStudio.Component.Debugger.JustInTime":{"version":"[17.0,18.0)","type":"Recommended"},"Microsoft.VisualStudio.Component.LiveUnitTesting_1779377902":{"i